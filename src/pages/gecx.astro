    status.textContent=t('booting');
    transcript.textContent=t('transcriptIdle');
    document.getElementById('diagnostic-output').textContent=t('noEvents');
    retry.textContent=t('retryVoice');
    function record(event,detail={}){
      if(!window.GecxDiagnostics)return;
      journal??=GecxDiagnostics.createJournal(40);
      journal.add(event,{attempt:generation,mode:demo.dataset.mode,language:language.value,...detail});
      document.getElementById('diagnostic-output').textContent=JSON.stringify({app:'gecx-browser-demo',sdk:'prod/latest',events:journal.entries()},null,2);
    }
    function controls(){
      start.disabled=!ready||pendingStart||chatBusy||!navigator.onLine;
      retry.disabled=!ready||pendingStart||chatBusy||!navigator.onLine;
      retry.hidden=error.dataset.action==='reload'||(pendingStart&&!active);
      chatSend.disabled=!ready||pendingStart||chatBusy||active||!navigator.onLine;
      language.disabled=active||pendingStart||chatBusy;
    }
    function clearError(){error.hidden=true;error.dataset.kind='';lastErrorDetail=null;}
    function presentError(detail){
      const info=GecxDiagnostics.describe({...detail,mode:demo.dataset.mode},uiLang());
      // The SDK can emit a generic follow-up after the detailed service error.
      if(!error.hidden&&['capacity','access'].includes(error.dataset.kind)&&['stream','chat-request'].includes(info.kind))return;
      lastErrorDetail=detail;
      error.dataset.kind=info.kind;error.dataset.action=info.action;document.getElementById('error-title').textContent=info.title;
      document.getElementById('error-message').textContent=info.message;
      retry.hidden=info.action==='reload';retry.textContent=demo.dataset.mode==='chat'?t('retryChat'):t('retryVoice');
      error.hidden=false;controls();
    }

    // Original procedural texture, drawn once. Audio animates the containing orb.
    function drawOrb() {
      const canvas=document.getElementById('orb-canvas'), ctx=canvas.getContext('2d');
      if (!ctx) return;
      const n=canvas.width, picture=ctx.createImageData(n,n), data=picture.data;
      const mix=(a,b,f)=>a.map((v,i)=>v*(1-f)+b[i]*f);
      for(let y=0;y<n;y++) for(let x=0;x<n;x++) {
        const u=(x+.5)/n*2-1,v=(y+.5)/n*2-1,r=u*u+v*v;
        if(r>1) continue;
        const z=Math.sqrt(1-r),i=(y*n+x)*4;
        const green=Math.exp(-((u+.37)**2/.65+(v+.57)**2/.7));
        const lime=Math.exp(-((u-.26)**2/.3+(v+.56)**2/.27));
        const light=Math.exp(-((u-.57)**2/.36+(v+.12)**2/.22));
        let c=mix([64,163,224],[57,116,68],green*.96);
        c=mix(c,[169,218,143],lime*.9); c=mix(c,[222,255,251],light*.94);
        const rim=Math.pow(1-z,3)*22,grain=(Math.sin(x*127.1+y*311.7)*43758.5453%1)*14,shade=.94+z*.09+u*.035;
        for(let k=0;k<3;k++) data[i+k]=Math.max(0,Math.min(255,c[k]*shade+rim+grain));
        data[i+3]=Math.min(255,(1-r)*n*128);
      }
      ctx.putImageData(picture,0,0);
    }
    drawOrb();
    function resetOrb(){
      orb.dataset.active='false';orb.dataset.muted='false';orbWrap.dataset.activity='idle';
      orbWrap.style.setProperty('--voice-level','0');orbWrap.style.setProperty('--signal-level','0');
    }
    function stopMeter(){
      cancelAnimationFrame(meterFrame);meterFrame=undefined;
      meterSource?.disconnect();meterSource=undefined;meterAnalyser=undefined;meterSamples=undefined;
      if(meterContext&&meterContext.state!=='closed')meterContext.close().catch(()=>{});
      meterContext=undefined;outputLevel=0;outputAt=0;userAt=0;smoothLevel=0;lastMeterPaint=0;
    }
    function startMeter(stream){
      stopMeter();
      try{
        // Analysis only: never connect this microphone source to the speakers.
        meterContext=new (window.AudioContext||window.webkitAudioContext)();
        meterContext.resume().catch(()=>{});
        meterSource=meterContext.createMediaStreamSource(stream);
        meterAnalyser=meterContext.createAnalyser();meterAnalyser.fftSize=512;
        meterSamples=new Float32Array(meterAnalyser.fftSize);meterSource.connect(meterAnalyser);
      }catch{/* The call and output feedback can continue without local metering. */}
      function paint(now){
        if(!active)return;
        meterFrame=requestAnimationFrame(paint);
        if(now-lastMeterPaint<32)return;lastMeterPaint=now;
        let rms=0;
        if(meterAnalyser&&!muted){meterAnalyser.getFloatTimeDomainData(meterSamples);for(const n of meterSamples)rms+=n*n;rms=Math.sqrt(rms/meterSamples.length);}
        if(rms>.007)userAt=now;
        const userSpeaking=!muted&&userAt>0&&now-userAt<350;
        const assistantSpeaking=outputAt>0&&now-outputAt<250;
        const voiceEnergy=Math.min(1,Math.sqrt(rms)*3.3);
        const incoming=assistantSpeaking?outputLevel:0;
        const breath=connected&&!muted ? .055+Math.sin(now/600)*.025 : 0;
        const target=Math.max(voiceEnergy,incoming,breath);
        smoothLevel+=(target-smoothLevel)*(target>smoothLevel ? .4 : .15);
        orbWrap.style.setProperty('--voice-level',smoothLevel.toFixed(3));
        orbWrap.style.setProperty('--signal-level',Math.min(1,smoothLevel*1.6).toFixed(3));
        const waiting=pendingResponseAt>0&&Date.now()-pendingResponseAt>2500;
        const activity=assistantSpeaking?'speaking':muted?'muted':userSpeaking?'hearing':waiting?'waiting':'listening';
        if(orbWrap.dataset.activity!==activity){
          orbWrap.dataset.activity=activity;
          if(connected)status.textContent=assistantSpeaking?(muted?t('speakingMuted'):t('speaking')):muted?t('muted'):userSpeaking?t('hearing'):waiting?t('waiting'):t('listening');
        }
      }
      meterFrame=requestAnimationFrame(paint);
    }
    function finish(message=t('ended'),kind='user') {
      if(!active)return;
      lastEnd={kind,at:Date.now()};active=false;connected=false;phase='idle';generation+=1;
      clearInterval(tick);clearTimeout(limit);clearTimeout(connectTimer);tick=undefined;pendingResponseAt=0;stopMeter();
      record('call-ended',{kind});
      try{messenger.presenter?.terminateBidiClient?.();}catch{/* Always release our microphone tracks. */}
      mediaStream?.getTracks().forEach(track=>track.stop());mediaStream=undefined;
      const returnFocus=document.activeElement===stop||document.activeElement===mute;
      start.hidden=false;stop.hidden=true;mute.hidden=true;status.textContent=message;resetOrb();controls();
      if(returnFocus)start.focus({preventScroll:true});
    }
    function showError(detail={},force=false) {
      record('error',detail);
      const lateError=['disconnect','error'].includes(lastEnd.kind)&&Date.now()-lastEnd.at<5000;
      if(!force&&!active&&!chatBusy&&!lateError)return;
      finish(t('endedError'),'error');
      if(chatBusy){chatStatus.textContent=t('chatIncomplete');}
      presentError(detail);
    }
    function waitForToken(reset=false){
      return GecxSessionAuth.waitForAuthorization({
        readState:()=>chatSdk.getContext()?.state,
        eventTarget:window,
        ...(reset?{reset:()=>messenger.startNewSession()}:{}),
      });
    }
    async function prepareSession(){
      await waitForToken(hasSession);hasSession=true;preferenceSent=false;record('session-ready');
    }
    async function applyVoicePreference(){
      if(!active||!connected||!mediaStream||preferenceSent)return;
      preferenceSent=true;
      if(!preferences[language.value])return;
      record('language-preference');pendingResponseAt=Date.now();
      try{await messenger.sendQuery(preferences[language.value]);}catch(failure){showError(failure);}
    }
    function initialize(){
      if(ready)return;
      if(!window.GecxDiagnostics||!window.GecxSessionAuth)return;
      chatSdk.registerContext(chatSdk.prebuilts.ces.createContext({
        deploymentName:'projects/501912525936/locations/us/apps/ed178bc4-49d8-4b9c-8422-dd76d3e1a445/deployments/36b553cc-337a-41ff-b788-f22789f63d08',
        tokenBroker:{enableTokenBroker:true,enableRecaptcha:true},enableWelcomeEvent:false,
      }));
      ready=true;controls();status.textContent=t('ready');record('sdk-ready');
    }
    window.addEventListener('chat-messenger-access-token-resolved',()=>record('authorization-ready'));
    window.addEventListener('chat-messenger-loaded',initialize,{once:true});
    setTimeout(()=>{if(!ready){status.textContent=t('sdkFailed');transcript.textContent=t('sdkFailedHint');if(window.GecxDiagnostics)presentError({kind:'sdk-load'});}},20000);
    async function startCall(){
      if(active||!ready||pendingStart||chatBusy)return;
      clearError();
      if(!navigator.onLine){showError({kind:'offline'},true);return;}
      if(!window.isSecureContext||!navigator.mediaDevices?.getUserMedia){showError({name:'SecurityError'},true);return;}
      pendingStart=true;phase='preparing';lastEnd={kind:'none',at:0};
      active=true;muted=false;start.hidden=true;stop.hidden=false;stop.focus({preventScroll:true});
      orb.dataset.active='true';const attempt=++generation;
      controls();record('call-start');status.textContent=t('preparingCall');transcript.textContent=t('micPrompt');timer.textContent='';
      connectTimer=setTimeout(()=>{if(active&&attempt===generation)showError({kind:'connect-timeout'});},45000);
      try{
        await prepareSession();
        if(attempt!==generation||!active)return;
        if(typeof messenger.presenter?.toggleBidiSession!=='function')throw {kind:'sdk-load'};
        phase='connecting';status.textContent=t('connecting');
        const stream=await messenger.presenter.toggleBidiSession(true);
        if(attempt!==generation||!active){stream?.getTracks().forEach(track=>track.stop());if(!active)messenger.presenter?.terminateBidiClient?.();return;}
        if(!stream){showError({kind:'empty-stream'});return;}
        mediaStream=stream;startMeter(stream);mute.hidden=false;mute.setAttribute('aria-pressed','false');mute.setAttribute('aria-label',t('muteOn'));mute.title=t('muteOn');document.getElementById('mute-slash').setAttribute('hidden','');
        stream.getAudioTracks().forEach(track=>track.addEventListener('ended',()=>{if(active&&mediaStream===stream)showError({name:'NotReadableError'});}));
        await applyVoicePreference();
      }catch(failure){if(attempt===generation)showError(failure);}
      finally{pendingStart=false;controls();}
    }
    start.addEventListener('click',startCall);
    stop.addEventListener('click',()=>{const pending=pendingStart;finish();if(pending)presentError({kind:'pending-cancel'});else clearError();});
    mute.addEventListener('click',()=>{
      if(!active||!mediaStream)return;
      muted=!muted;mediaStream.getAudioTracks().forEach(track=>track.enabled=!muted);
      record(muted?'microphone-muted':'microphone-unmuted');
      mute.setAttribute('aria-pressed',String(muted));mute.setAttribute('aria-label',muted?t('muteOff'):t('muteOn'));mute.title=mute.getAttribute('aria-label');
      document.getElementById('mute-slash').toggleAttribute('hidden',!muted);orb.dataset.muted=String(muted);orbWrap.dataset.activity='';status.textContent=muted?t('muted'):t('listening');
    });
    messenger.addEventListener('chat-messenger-connect-bidi',()=>{
      if(!active||phase==='preparing')return;
      connected=true;phase='connected';clearTimeout(connectTimer);record('connected');status.textContent=t('listening');transcript.textContent=t('micActive');
      if(!tick){
        startedAt=Date.now();timer.textContent='0:00';
        limit=setTimeout(()=>finish(t('limitReached'),'limit'),240000);
        tick=setInterval(()=>{
          const s=Math.floor((Date.now()-startedAt)/1000);timer.textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0');
          if(pendingResponseAt&&Date.now()-pendingResponseAt>20000&&error.hidden){record('response-slow');presentError({kind:'response-timeout'});}
          if(s>=240)finish(t('limitReached'),'limit');
        },1000);
      }
      applyVoicePreference();
    });
    function responseArrived(){pendingResponseAt=0;if(error.dataset.kind==='response-timeout')clearError();}
    messenger.addEventListener('chat-messenger-bidi-transcript-updated',({detail})=>{if(active&&detail?.transcript){transcript.textContent=t('you')+': '+detail.transcript;pendingResponseAt=Date.now();}});
    messenger.addEventListener('chat-messenger-bidi-utterance-updated',({detail})=>{if(active&&detail?.utterance){transcript.textContent=detail.utterance;responseArrived();}});
    messenger.addEventListener('chat-messenger-audio-playback-payload',({detail})=>{
      if(!active||!detail?.audio?.length)return;
      const mean=detail.audio.reduce((sum,n)=>sum+n,0)/detail.audio.length;
      outputLevel=Math.min(1,Math.sqrt(mean/100)*1.8);if(mean>1.5){outputAt=performance.now();responseArrived();}
    });
    messenger.addEventListener('chat-messenger-disconnect-bidi',()=>{
      record('disconnected');if(!active||phase==='preparing')return;
      finish(t('dropped'),'disconnect');presentError({kind:'stream'});
    });
    messenger.addEventListener('chat-messenger-session-ended',()=>{
      record('agent-ended');
      if(active){finish(t('remoteEnded'),'remote');clearError();}
      else if(lastEnd.kind==='disconnect'&&Date.now()-lastEnd.at<2000){status.textContent=t('remoteEnded');clearError();lastEnd.kind='remote';}
    });
    messenger.addEventListener('chat-messenger-error',e=>showError(e.detail||{}));
    messenger.addEventListener('chat-messenger-error-v2',e=>showError(e.detail||{}));
    function addChatMessage(role,text){
      document.getElementById('chat-empty')?.remove();
      const item=document.createElement('div');item.className='gcx-chat-message';item.dataset.role=role;
      const who=document.createElement('strong');who.textContent=role==='user'?t('you'):t('agent');
      const body=document.createElement('span');body.textContent=text;item.append(who,body);chatLog.append(item);chatLog.scrollTop=chatLog.scrollHeight;
    }
    messenger.addEventListener('chat-messenger-response-received',({detail})=>{
      if(!chatBusy||demo.dataset.mode!=='chat')return;
      const text=(detail?.messages||[]).filter(m=>m.type==='text'&&typeof m.text==='string').map(m=>m.text).join('\n');
      if(text){chatResponseCount++;addChatMessage('agent',text);chatStatus.textContent=t('chatReceived');if(['response-timeout','chat-response-timeout'].includes(error.dataset.kind))clearError();}
    });
    document.getElementById('chat-form').addEventListener('submit',async event=>{
      event.preventDefault();const text=chatInput.value.trim();if(!text||chatBusy||active||pendingStart||!ready)return;
      if(!navigator.onLine){showError({kind:'offline'},true);return;}
      clearError();chatBusy=true;const attempt=++chatGeneration;const responseBefore=chatResponseCount;controls();chatStatus.textContent=t('chatWaiting');addChatMessage('user',text);chatInput.value='';record('chat-request');
      chatTimer=setTimeout(()=>{if(chatBusy&&attempt===chatGeneration){chatStatus.textContent=t('chatSlow');presentError({kind:'chat-response-timeout'});}},20000);
      try{
        await waitForToken();if(attempt!==chatGeneration)return;hasSession=true;
        const prefix=!preferenceSent&&preferences[language.value]?preferences[language.value]+'\n\n':'';preferenceSent=true;
        await messenger.sendQuery(prefix+text);
        if(attempt===chatGeneration&&responseBefore===chatResponseCount&&error.hidden)chatStatus.textContent=t('chatNoText');
      }catch(failure){if(attempt===chatGeneration)showError(failure);}
      finally{if(attempt===chatGeneration){chatBusy=false;clearTimeout(chatTimer);controls();}}
    });
    retry.addEventListener('click',async()=>{
      if(pendingStart||chatBusy)return;
      if(demo.dataset.mode==='voice'){finish(t('restarting'),'retry');startCall();}
      else{clearError();pendingStart=true;controls();chatStatus.textContent=t('chatPreparing');try{await prepareSession();chatStatus.textContent=t('chatReady');chatLog.replaceChildren();}catch(failure){showError(failure,true);}finally{pendingStart=false;controls();}}
    });
    reload.addEventListener('click',()=>{finish(t('reloading'),'reload');location.reload();});
    language.addEventListener('change',()=>{preferenceSent=false;record('language-selected');document.getElementById('language-hint').textContent=language.value==='auto'?t('langHintAuto'):t('langHintSet');});
    function setMode(mode){
      if(mode===demo.dataset.mode)return;
      if(chatBusy||pendingStart)return;
      finish(t('modeEnded'),'mode');clearError();
      const voiceMode=mode==='voice';demo.dataset.mode=mode;voiceView.hidden=!voiceMode;chatView.hidden=voiceMode;record('mode-changed');
      for(const[tab,selected]of[[voiceTab,voiceMode],[chatTab,!voiceMode]]){tab.setAttribute('aria-selected',String(selected));tab.tabIndex=selected?0:-1;}
    }
    voiceTab.addEventListener('click',()=>setMode('voice'));chatTab.addEventListener('click',()=>setMode('chat'));
    document.querySelector('.gcx-modes').addEventListener('keydown',event=>{
      if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;
      event.preventDefault();const mode=event.key==='Home'?'voice':event.key==='End'?'chat':demo.dataset.mode==='voice'?'chat':'voice';setMode(mode);(mode==='voice'?voiceTab:chatTab).focus();
    });
    document.getElementById('help-toggle').addEventListener('click',event=>{
      const panel=document.getElementById('help-panel');panel.hidden=!panel.hidden;event.currentTarget.setAttribute('aria-expanded',String(!panel.hidden));
      if(!panel.hidden)panel.scrollIntoView({block:'nearest',behavior:'instant'});
    });
    document.getElementById('copy-diagnostics').addEventListener('click',async()=>{
      const feedback=document.getElementById('copy-status');
      try{await navigator.clipboard.writeText(document.getElementById('diagnostic-output').textContent);feedback.textContent=t('copyOk');}catch{feedback.textContent=t('copyFail');}
    });
    window.addEventListener('offline',()=>{record('offline');if(active||chatBusy)showError({kind:'offline'},true);controls();});
    window.addEventListener('online',()=>{record('online');controls();});
    window.addEventListener('error',event=>{if(event.filename?.startsWith('https://www.gstatic.com/chat-messenger/'))record('sdk-ui-exception');});
    window.addEventListener('pagehide',()=>finish(t('closed'),'pagehide'));

    /* Troca de idioma do portfólio: reescreve o que é gerado em tempo de execução. */
    new MutationObserver(() => {
      if(!active&&!chatBusy&&!pendingStart){
        status.textContent=ready?t('ready'):t('booting');
        transcript.textContent=t('transcriptIdle');
      }
      retry.textContent=demo.dataset.mode==='chat'?t('retryChat'):t('retryVoice');
      document.getElementById('language-hint').textContent=language.value==='auto'?t('langHintAuto'):t('langHintSet');
      if(!journal)document.getElementById('diagnostic-output').textContent=t('noEvents');
      if(lastErrorDetail&&!error.hidden)presentError(lastErrorDetail);
    }).observe(document.documentElement,{attributes:true,attributeFilter:['data-lang']});
  </script>

</body>
</html>
