---
// src/pages/gecx.astro
// ────────────────────
// Página dedicada ao projeto de atendimento com IA (Gemini Enterprise CX).
// Ordem obrigatória: primeiro a explicação do produto, depois a demonstração.
// O chat não aparece mais na home.
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

import '../styles/global.css';
---

<!DOCTYPE html>
<html
  lang="pt-BR"
  data-theme="dark"
  data-lang="pt"
  data-title-pt="Helpdesk com IA — Eduardo Ritter"
  data-title-en="AI Helpdesk — Eduardo Ritter"
>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Helpdesk com IA — Eduardo Ritter</title>
  <meta name="description" content="Agente de helpdesk construído no Gemini Enterprise CX: o que resolve, como funciona, que stack usa e uma demonstração por voz ou chat no navegador." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Aplica tema antes de renderizar (evita flash) -->
  <script is:inline>
    (function () {
      var s = localStorage.getItem('theme');
      var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', s || (d ? 'dark' : 'light'));
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Display:wght@400;500&family=Google+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <script is:inline defer src="/gemini-cx-demo/diagnostics.js"></script>
  <script is:inline defer src="/gemini-cx-demo/session-auth.js"></script>
  <script is:inline defer src="https://www.gstatic.com/chat-messenger/sdk/prod/latest/chat-messenger.js"></script>
  <link rel="stylesheet" href="https://www.gstatic.com/chat-messenger/sdk/prod/latest/themes/chat-messenger-default.css" />
</head>

<body>

  <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

  <Nav base="/" />

  <main class="gcx-page">

    <!-- ── Abertura ─────────────────────────────────────────── -->
    <section class="gcx-hero">
      <div class="container">
        <p class="label gcx-kicker" data-i18n="gecx.kicker">PROJETO · ATENDIMENTO COM IA</p>
        <h1 class="gcx-title" data-i18n="gecx.title">Um helpdesk que atende por voz.</h1>
        <p class="gcx-lead" data-i18n="gecx.lead">Agente de suporte interno construído no Gemini Enterprise CX, a plataforma de Customer Experience do Google. Esta página explica o que ele faz e como foi montado. A demonstração fica no fim, quando você já souber o que está testando.</p>
        <ul class="gcx-facts">
          <li data-i18n="gecx.fact1">Voz e texto na mesma sessão</li>
          <li data-i18n="gecx.fact2">Respostas fundamentadas numa base própria</li>
          <li data-i18n="gecx.fact3">Ambiente de teste com dados fictícios</li>
        </ul>
        <a class="gcx-jump" href="#demonstracao" data-i18n="gecx.jump">Pular para a demonstração ↓</a>
      </div>
    </section>

    <!-- ── 01. O que é ──────────────────────────────────────── -->
    <section class="section reveal-section" id="o-que-e" aria-labelledby="gecx-what-title">
      <div class="container">
        <div class="section-header">
          <span class="section-index">01</span>
          <h2 id="gecx-what-title" data-i18n="gecx.what.title">O que é</h2>
        </div>
        <div class="gcx-two-col">
          <div class="gcx-prose">
            <p data-i18n="gecx.what.p1">Gemini Enterprise CX é a plataforma de atendimento do Google. O agente é descrito no CX Agent Studio, recebe as fontes de conhecimento e as ferramentas que pode chamar, e vira um deployment publicado. O navegador conversa com esse deployment pelo widget web oficial, que cuida da autorização, do streaming de áudio e da reprodução das respostas.</p>
            <p data-i18n="gecx.what.p2">O agente deste projeto é um helpdesk interno. Ele nasceu como prova de conceito para resolver o primeiro nível de suporte: acesso ao portal, redefinição de senha, VPN fora do ar e situação de um chamado. Quando a orientação não resolve, ele encaminha para uma fila humana.</p>
          </div>
          <div class="gcx-aside">
            <article class="gcx-card">
              <h3 data-i18n="gecx.who.title">Para quem</h3>
              <p data-i18n="gecx.who.text">Times de suporte interno que recebem os mesmos pedidos todo dia e querem tirar esse volume da fila humana sem perder o caminho de escalonamento.</p>
            </article>
            <article class="gcx-card">
              <h3 data-i18n="gecx.solves.title">O que resolve</h3>
              <p data-i18n="gecx.solves.text">Respostas apoiadas em documentos reais em vez de texto genérico, o mesmo agente atendendo por voz e por escrita, e um critério explícito para saber quando parar de tentar e chamar uma pessoa.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 02. Como funciona ────────────────────────────────── -->
    <section class="section reveal-section" id="como-funciona" aria-labelledby="gecx-how-title">
      <div class="container">
        <div class="section-header">
          <span class="section-index">02</span>
          <h2 id="gecx-how-title" data-i18n="gecx.how.title">Como funciona</h2>
        </div>
        <ol class="gcx-steps">
          <li class="reveal-item" style="--delay:.05s">
            <h3 data-i18n="gecx.how.s1.title">Autorização sem chave na página</h3>
            <p data-i18n="gecx.how.s1.text">O SDK do Google pede o token a um token broker com reCAPTCHA. Esta página não guarda credencial e não fala direto com a API do serviço.</p>
          </li>
          <li class="reveal-item" style="--delay:.1s">
            <h3 data-i18n="gecx.how.s2.title">Uma sessão, dois modos</h3>
            <p data-i18n="gecx.how.s2.text">A voz usa o fluxo bidirecional do CES, com o microfone capturado pelo próprio SDK. O texto usa o caminho de chat da mesma sessão. Trocar de modo muda só a interface, sem recomeçar a conversa.</p>
          </li>
          <li class="reveal-item" style="--delay:.15s">
            <h3 data-i18n="gecx.how.s3.title">Consulta à base de conhecimento</h3>
            <p data-i18n="gecx.how.s3.text">As respostas vêm de um data store indexado com o material do helpdesk: acesso ao portal, identidade, conectividade e critérios de transbordo. Cada resposta se apoia nesse conteúdo em vez de inventar o procedimento.</p>
          </li>
          <li class="reveal-item" style="--delay:.2s">
            <h3 data-i18n="gecx.how.s4.title">Ferramentas e chamados</h3>
            <p data-i18n="gecx.how.s4.text">O agente consulta a situação de um chamado e pede confirmação antes de abrir um novo. Depois de um erro nada é reenviado automaticamente, porque um pedido sem resposta visível pode já ter sido executado do outro lado.</p>
          </li>
          <li class="reveal-item" style="--delay:.25s">
            <h3 data-i18n="gecx.how.s5.title">Quando chamar uma pessoa</h3>
            <p data-i18n="gecx.how.s5.text">O agente encaminha quando o usuário pede uma pessoa, quando há risco de segurança, quando o problema é crítico ou quando duas tentativas de orientação não resolvem o caso.</p>
          </li>
          <li class="reveal-item" style="--delay:.3s">
            <h3 data-i18n="gecx.how.s6.title">Idioma como instrução</h3>
            <p data-i18n="gecx.how.s6.text">Português do Brasil, inglês dos EUA, espanhol da Espanha e italiano estão configurados no agente. A escolha do seletor vai como instrução da conversa, não como troca de modelo de voz nem como tradutor.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ── 03. Stack ────────────────────────────────────────── -->
    <section class="section reveal-section" id="stack" aria-labelledby="gecx-stack-title">
      <div class="container">
        <div class="section-header">
          <span class="section-index">03</span>
          <h2 id="gecx-stack-title" data-i18n="gecx.stack.title">Stack</h2>
        </div>
        <ul class="gcx-stack">
          <li class="reveal-item" style="--delay:.05s">
            <strong>Gemini Enterprise CX</strong>
            <span data-i18n="gecx.stack.i1">API CES v1beta. Agente, deployment, versões e sessões, tudo gerenciável por API.</span>
          </li>
          <li class="reveal-item" style="--delay:.1s">
            <strong>CX Agent Studio</strong>
            <span data-i18n="gecx.stack.i2">Instruções do agente, idiomas suportados, voz e regras de segurança.</span>
          </li>
          <li class="reveal-item" style="--delay:.15s">
            <strong>Vertex AI Search</strong>
            <span data-i18n="gecx.stack.i3">Data store que indexa a base de conhecimento consultada durante a conversa.</span>
          </li>
          <li class="reveal-item" style="--delay:.2s">
            <strong>Widget chat-messenger</strong>
            <span data-i18n="gecx.stack.i4">Componente web oficial do Google: autorização, captura de áudio, streaming e eventos.</span>
          </li>
          <li class="reveal-item" style="--delay:.25s">
            <strong>Astro + JavaScript</strong>
            <span data-i18n="gecx.stack.i5">Interface desta página, sem framework: esfera de áudio, estados, chat próprio e recuperação de erro.</span>
          </li>
          <li class="reveal-item" style="--delay:.3s">
            <strong>Módulo de diagnóstico</strong>
            <span data-i18n="gecx.stack.i6">Classifica os códigos de erro do SDK e guarda um registro curto, só na memória do navegador.</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- ── 04. Limites ──────────────────────────────────────── -->
    <section class="section reveal-section" id="limites" aria-labelledby="gecx-limits-title">
      <div class="container">
        <div class="section-header">
          <span class="section-index">04</span>
          <h2 id="gecx-limits-title" data-i18n="gecx.limits.title">Limites e privacidade</h2>
        </div>
        <ul class="gcx-limits">
          <li data-i18n="gecx.limits.i1">Os dados desta demonstração são fictícios. Não escreva senha, dado pessoal ou informação confidencial.</li>
          <li data-i18n="gecx.limits.i2">Cada chamada de voz tem limite de quatro minutos, contado a partir da confirmação da ligação.</li>
          <li data-i18n="gecx.limits.i3">O transbordo para atendimento humano é simulado. Não existe fila real nem número de telefone.</li>
          <li data-i18n="gecx.limits.i4">O áudio é processado pelo Google e a conversa pode ser registrada conforme a configuração do projeto.</li>
          <li data-i18n="gecx.limits.i5">O registro de diagnóstico fica só na memória desta aba. Ele não guarda áudio, mensagens, nomes nem tokens.</li>
          <li data-i18n="gecx.limits.i6">Português de Portugal não consta da lista oficial de vozes. Escolher português entrega a voz de português do Brasil.</li>
        </ul>
      </div>
    </section>

    <!-- ── 05. Demonstração ─────────────────────────────────── -->
    <section class="section gcx-demo-section is-visible" id="demonstracao" aria-labelledby="gecx-demo-title">
      <div class="container">
        <div class="section-header">
          <span class="section-index">05</span>
          <h2 id="gecx-demo-title" data-i18n="gecx.demo.title">Demonstração</h2>
        </div>
        <p class="gcx-demo-lead" data-i18n="gecx.demo.lead">Agora o agente. Escolha <strong>voz</strong> para falar com ele ou <strong>chat</strong> para escrever. É o mesmo agente e a mesma conversa nos dois casos.</p>

        <div id="demo" class="gcx-demo" data-mode="voice" aria-label="Assistente Helpdesk">
          <div class="gcx-settings-row">
            <label for="language" data-i18n="gecx.demo.language">Idioma da conversa</label>
            <select id="language" aria-describedby="language-hint">
              <option value="auto" data-i18n="gecx.demo.lang.auto">Automático</option>
              <option value="pt-BR">Português (Brasil)</option>
              <option value="en-US">English (US)</option>
              <option value="es-ES">Español (España)</option>
            </select>
            <p id="language-hint" data-i18n="gecx.demo.langHintAuto">Fale no idioma desejado.</p>
          </div>

          <div class="gcx-workspace">
            <div id="voice-view" class="gcx-voice-view" role="tabpanel" aria-labelledby="voice-tab">
              <div class="gcx-orb-wrap">
                <div id="orb" class="gcx-orb" aria-hidden="true"><canvas id="orb-canvas" width="480" height="480"></canvas></div>
                <div class="gcx-call-switch">
                  <button id="start" class="gcx-call-button" type="button" aria-label="Iniciar chamada" title="Iniciar chamada" data-i18n-aria="gecx.demo.start" disabled><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-2.6a1 1 0 0 0-.8-1l-3.3-.7a1 1 0 0 0-1 .3l-1.8 1.8a14.7 14.7 0 0 1-7.9-7.9L8 8.1a1 1 0 0 0 .3-1l-.7-3.3a1 1 0 0 0-1-.8Z"/></svg></button>
                  <button id="stop" class="gcx-call-button" type="button" aria-label="Terminar chamada" title="Terminar chamada" data-i18n-aria="gecx.demo.stop" hidden><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2.2 10.5a17 17 0 0 1 19.6 0c.8.6 1.1 1.6.7 2.5l-1 2.1c-.2.5-.8.8-1.3.6l-3.8-1.1c-.5-.1-.8-.6-.8-1.1v-2.1a14 14 0 0 0-7.2 0v2.1c0 .5-.3 1-.8 1.1l-3.8 1.1c-.5.2-1.1-.1-1.3-.6l-1-2.1c-.4-.9-.1-1.9.7-2.5Z"/></svg></button>
                </div>
              </div>
              <div class="gcx-conversation">
                <div class="gcx-status-line"><span id="status" role="status">A preparar o assistente…</span><span id="timer" aria-label="Duração da chamada"></span></div>
                <p id="transcript" class="gcx-transcript" aria-live="polite" aria-atomic="true">Autoriza o microfone e fala naturalmente.</p>
              </div>
            </div>

            <div id="chat-view" class="gcx-chat-view" role="tabpanel" aria-labelledby="chat-tab" hidden>
              <div id="chat-log" class="gcx-chat-log" role="log" aria-label="Mensagens da conversa" aria-live="polite"><p id="chat-empty" class="gcx-chat-empty" data-i18n="gecx.demo.chatEmpty">Escreva para o mesmo assistente.<br />Use apenas dados fictícios neste teste.</p></div>
              <p id="chat-status" role="status"></p>
              <form id="chat-form" class="gcx-chat-form"><label class="gcx-sr-only" for="chat-input" data-i18n="gecx.demo.yourMessage">A sua mensagem</label><textarea id="chat-input" rows="2" maxlength="4000" placeholder="Escreva a sua mensagem…" data-i18n-placeholder="gecx.demo.chatPlaceholder" required></textarea><button id="chat-send" type="submit" data-i18n="gecx.demo.send" disabled>Enviar</button></form>
            </div>

            <div id="sdk-host" class="gcx-sdk-host" aria-hidden="true" inert>
              <chat-messenger id="voice" language-code="pt" disable-viewport-management url-allowlist="*"><chat-messenger-container chat-title="Assistente Helpdesk" no-titlebar enable-audio-input-only></chat-messenger-container></chat-messenger>
            </div>
          </div>

          <section id="error" aria-label="Estado da ligação" hidden>
            <div role="alert"><strong id="error-title"></strong><p id="error-message"></p></div>
            <div class="gcx-recovery-actions"><button id="retry" type="button">Voltar a ligar</button><button id="reload" type="button" data-i18n="gecx.demo.reload">Atualizar página</button></div>
          </section>

          <div class="gcx-toolbar">
            <div class="gcx-agent"><div class="gcx-avatar" aria-hidden="true"><span></span></div><div class="gcx-agent-name">Assistente Helpdesk<span class="gcx-agent-provider">Google · Gemini Enterprise CX</span></div></div>
            <div class="gcx-modes" role="tablist" aria-label="Modo de conversa">
              <button id="voice-tab" type="button" role="tab" aria-selected="true" aria-controls="voice-view" data-i18n="gecx.demo.tabVoice">Voz</button>
              <button id="chat-tab" type="button" role="tab" aria-selected="false" aria-controls="chat-view" tabindex="-1" data-i18n="gecx.demo.tabChat">Chat</button>
            </div>
            <div class="gcx-toolbar-actions">
              <button id="mute" class="gcx-mute-button" type="button" aria-label="Silenciar microfone" aria-pressed="false" title="Silenciar microfone" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8"/><path id="mute-slash" d="m3 3 18 18" hidden/></svg></button>
              <button id="help-toggle" class="gcx-help-button" type="button" aria-expanded="false" aria-controls="help-panel" data-i18n="gecx.demo.help">Ajuda e idiomas</button>
            </div>
          </div>
        </div>

        <section id="help-panel" class="gcx-help-panel" aria-label="Sugestões para o teste" hidden>
          <div><h3 data-i18n="gecx.help.h1">Comece uma conversa</h3><p data-i18n="gecx.help.p1">Clique no telefone e permita o acesso ao microfone. Experimente: “Olá, sou o Eduardo. Preciso de ajuda com o acesso à VPN.” Use fones para evitar eco.</p></div>
          <div><h3 data-i18n="gecx.help.h2">Explore o assistente</h3><p data-i18n="gecx.help.p2">Você pode pedir ajuda, consultar um chamado ou mudar para Chat e escrever. A passagem para um atendente humano nesta demonstração é simulada.</p></div>
          <div><h3 data-i18n="gecx.help.h3">Microfone e ligação são coisas diferentes</h3><p data-i18n="gecx.help.p3">A esfera reage à captação local e ao áudio do assistente. Movimento não garante resposta do Google. O estado indica quando estamos aguardando. O mudo permite continuar ouvindo, sem enviar a sua voz, e não suspende o tempo da chamada.</p></div>
          <div><h3 data-i18n="gecx.help.h4">Se a conversa parar</h3><p data-i18n="gecx.help.p4">Cada chamada tem limite de quatro minutos, contado a partir da ligação. A mensagem de erro distingue inatividade, microfone, acesso e limites quando o Google fornece essa informação. “Voltar a ligar” começa uma nova conversa, sem repetir pedidos automaticamente nem abrir o microfone sem o seu clique.</p></div>
          <details class="gcx-wide">
            <summary data-i18n="gecx.help.langSummary">Idiomas, vozes e português de Portugal</summary>
            <p data-i18n="gecx.help.lang1">O seletor envia uma preferência de idioma como instrução da conversa. Ele não troca o modelo de voz nem funciona como tradutor separado. Em Automático, fale direto no idioma desejado. O comportamento depende das instruções e dos idiomas suportados pelo agente.</p>
            <p data-i18n="gecx.help.lang2">Português de Portugal (pt-PT) não consta da lista oficial de voz do CX Agent Studio. Consta português do Brasil (pt-BR). Preferir palavras como “telemóvel” não garante sotaque português. Para chat escrito, os modelos Gemini cobrem mais idiomas.</p>
            <ul>
              <li data-i18n="gecx.help.langGa"><strong>Disponibilidade geral:</strong> português do Brasil; inglês dos EUA; francês da França e do Canadá; alemão da Alemanha; espanhol da Espanha e dos EUA.</li>
              <li data-i18n="gecx.help.langPreview"><strong>Preview:</strong> inglês do Reino Unido, Austrália, Canadá e Índia; espanhol do México; neerlandês; mandarim, dinamarquês, finlandês, hindi, hinglish, indonésio, italiano, japonês, coreano, marata, polonês, romeno, spanglish, sueco, tâmil, telugo, turco e vietnamita.</li>
            </ul>
            <p class="gcx-sources"><span data-i18n="gecx.help.langChecked">Lista consultada em 11/09/2026.</span> <a href="https://docs.cloud.google.com/gemini-enterprise-cx/cx-agent-studio/reference/language" target="_blank" rel="noopener noreferrer">Idiomas oficiais</a> · <a href="https://docs.cloud.google.com/gemini-enterprise-cx/cx-agent-studio/settings" target="_blank" rel="noopener noreferrer">Definições de idioma e voz</a></p>
          </details>
        </section>

        <details class="gcx-diagnostics">
          <summary data-i18n="gecx.diag.summary">Diagnóstico deste teste</summary>
          <p data-i18n="gecx.diag.text">Eventos desta página, mantidos apenas em memória. Não inclui áudio, mensagens, nomes, credenciais nem tokens. Copie este registro se precisar reportar um erro.</p>
          <button id="copy-diagnostics" type="button" data-i18n="gecx.diag.copy">Copiar diagnóstico</button><span id="copy-status" role="status"></span>
          <pre id="diagnostic-output">Ainda sem eventos.</pre>
        </details>

        <p class="gcx-demo-footnote"><span data-i18n="gecx.demo.footnote">Use dados fictícios. O áudio é processado pelo Google e a conversa pode ser registrada. O consumo do serviço pode gerar custos.</span> <span class="gcx-limit" data-i18n="gecx.demo.limit">Limite por chamada: 4 minutos</span></p>
      </div>
    </section>

  </main>

  <Footer />

  <script>
    import '../scripts/main.js';
  </script>

  <style is:global>
    /* ==========================================================
       Página GECX. Reaproveita os tokens do portfólio
       (--bg, --bg-surface, --border, --text-1, --accent…)
       e funciona nos temas claro e escuro.
       ========================================================== */

    [data-theme="dark"]  { color-scheme: dark; }
    [data-theme="light"] { color-scheme: light; }

    /* As regras de classe abaixo definem display, então o [hidden] do
       navegador precisa continuar vencendo (vista de chat, painel de
       ajuda, botões de terminar e silenciar). */
    [hidden] { display: none !important; }

    .gcx-page { position: relative; z-index: 1; }

    /* ── Abertura ─────────────────────────────────────────── */
    .gcx-hero { padding: calc(var(--header-h) + clamp(56px, 9vw, 110px)) 0 clamp(30px, 5vw, 56px); }
    .gcx-kicker { display: block; margin-bottom: 22px; color: var(--accent); }
    .gcx-title {
      font-family: var(--font-display-editorial);
      font-size: clamp(2.4rem, 6.4vw, 4.6rem);
      font-weight: 300;
      line-height: 1.02;
      letter-spacing: -0.03em;
      max-width: 16ch;
    }
    .gcx-lead {
      max-width: 62ch;
      margin-top: 26px;
      font-size: clamp(0.95rem, 1.5vw, 1.1rem);
      line-height: 1.75;
      color: color-mix(in srgb, var(--text-1) 72%, transparent);
    }
