---
// src/pages/pix-golpe.astro
// ──────────────────────────
// Lab Pix — resultado salvo da corrida "Detector de Golpe do Pix" com os três lados em Rust:
// JEV + Rust vs Gemini + Rust vs Laya + Rust (só o modelo muda; o Gemini ocupa o lugar do DeepSeek do vídeo). Tudo é estático: os números vêm do
// snapshot gravado da execução real (src/data/pix-golpe/corrida.json) e são calculados no build,
// com o mesmo critério do relatório final do app (grupos, estrela só nas linhas comparáveis, placar por grupo).
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import corrida from '../data/pix-golpe/corrida.json';

import '../styles/global.css';

type Ev = any;
const C: any = corrida;
const eventos: Ev[] = C.eventos;
const app = C.app ?? {};
const dados = C.dados ?? {};
const ladosInfo = C.lados ?? {};
const execucao = C.execucao ?? {};

const LADOS = [
  { id: 'jev',      nome: 'JEV + Rust',      curto: 'JEV',      modelo: 'TypeSafe JEV',                           onde: 'API TypeSafe' },
  { id: 'deepseek', nome: 'Gemini + Rust',   curto: 'Gemini',   modelo: 'Gemini 2.5 Flash, do Google',            onde: 'API do Google (compatível com OpenAI)' },
  { id: 'laya',     nome: 'Laya + Rust',     curto: 'Laya',     modelo: 'Convai Laya, modelo aberto',             onde: 'local na GPU (RTX 4070)' },
] as const;

const fins: Record<string, Ev> = Object.fromEntries(LADOS.map(l => [l.id, eventos.find(e => e.tipo === 'fim' && e.lado === l.id)]));
const ordem = eventos.filter(e => e.tipo === 'fim').sort((a, b) => a.seq - b.seq).map(e => e.lado);
const pos = (id: string) => ordem.indexOf(id) + 1;
const msgs = (id: string) => eventos.filter(e => e.tipo === 'mensagem' && e.lado === id).sort((a, b) => a.idx - b.idx);

// ---------- formatação pt-BR ----------
const nf = (v: number, d = 0) => v.toLocaleString('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d });
const fmtInt = (v: number) => nf(Math.round(v));
function fmtMs(ms: number | null | undefined) {
  if (ms == null) return '—';
  if (ms < 1) return nf(ms * 1000) + ' µs';
  if (ms < 10) return nf(ms, 1) + ' ms';
  if (ms < 1000) return nf(ms) + ' ms';
  if (ms < 60000) return nf(ms / 1000, 1) + ' s';
  const s = Math.floor(ms / 1000);
  return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0') + ' min';
}
const fmtUSD = (v: number) => 'US$ ' + (v === 0 ? '0' : v < 0.001 ? nf(v, 6) : nf(v, 4));
const fmtMem = (mb: number) => (mb >= 1024 ? nf(mb / 1024, 1) + ' GB' : nf(mb, mb < 100 ? 1 : 0) + ' MB');
const fmtPct1 = (v: number) => nf(v * 100, 1) + '%';
const fmtBRL = (c: number) => 'R$ ' + nf(c / 100, 2);
function fmtDelta(seg: number) {
  const a = Math.abs(seg);
  if (a < 3600) return '+' + Math.round(a / 60) + ' min';
  if (a < 86400) return '+' + nf(a / 3600, 1) + ' h';
  return '+' + nf(a / 86400, 1) + ' d';
}

// ---------- métricas por lado (mesmos campos do relatório do app, SPEC §11.3) ----------
const M: Record<string, any> = Object.fromEntries(LADOS.map(l => {
  const f = fins[l.id];
  return [l.id, {
    k: l.id, f, proc: f.processadas, reais: f.golpes_reais, sinal: f.sinalizados ?? f.golpes_detectados,
    vp: f.verdadeiros_positivos, fp: f.falsos_positivos, fn: f.falsos_negativos, vn: f.verdadeiros_negativos,
    precisao: f.precisao, cobertura: f.cobertura, acuracia: f.acuracia, saques: f.saques_encontrados, erros: f.erros,
    chegada: pos(l.id), total: f.total_ms, ia: f.tempo_ia_ms, grafo: f.tempo_grafo_ms, outros: f.tempo_outros_ms,
    p50d: f.p50_decisao_ms, mediad: f.media_decisao_ms, p50r: f.p50_rastreio_ms, mediar: f.media_rastreio_ms,
    custoApi: f.custo_api_usd, custoMaq: f.custo_maquina_usd ?? null, custoTotal: f.custo_total_usd, custoMsg: f.custo_por_mensagem_usd,
    premissa: f.premissa_custo, tokIn: f.tokens_in, tokOut: f.tokens_out ?? null, tokInMsg: f.tokens_in_por_mensagem,
    onde: f.modelo_onde, ram: f.modelo_ram_mb ?? null, vram: f.modelo_vram_mb ?? null,
  }];
}));
const golpesReais = M.jev.reais;
const total = M.jev.proc;

type Linha = { chave: string; nome: string; get?: (m: any) => any; melhor?: 'menor' | 'maior'; fmt?: (v: any, m: any) => string;
  vazio?: (m: any) => string; texto?: boolean; foraDoPlacar?: boolean; destaque?: boolean; app?: boolean };
const GRUPOS: { chave: string; nome: string; linhas: Linha[] }[] = [
  { chave: 'pix.g.acerto', nome: 'Acerto', linhas: [
    { chave: 'pix.r.proc',   nome: 'mensagens processadas', get: m => m.proc, fmt: fmtInt },
    { chave: 'pix.r.sinal',  nome: 'sinalizados como golpe', get: m => m.sinal, fmt: fmtInt },
    { chave: 'pix.r.vp',     nome: 'golpes pegos (VP) / reais', get: m => m.vp, melhor: 'maior', fmt: (v, m) => fmtInt(v) + ' / ' + fmtInt(m.reais), destaque: true },
    { chave: 'pix.r.fp',     nome: 'alarmes falsos (FP)', get: m => m.fp, melhor: 'menor', fmt: fmtInt, destaque: true },
    { chave: 'pix.r.fn',     nome: 'golpes perdidos (FN)', get: m => m.fn, melhor: 'menor', fmt: fmtInt },
    { chave: 'pix.r.vn',     nome: 'legítimas liberadas (VN)', get: m => m.vn, melhor: 'maior', fmt: fmtInt },
    { chave: 'pix.r.prec',   nome: 'precisão (VP / sinalizados)', get: m => m.precisao, melhor: 'maior', fmt: fmtPct1, vazio: () => 'nada sinalizado', destaque: true },
    { chave: 'pix.r.cob',    nome: 'cobertura (VP / reais)', get: m => m.cobertura, melhor: 'maior', fmt: fmtPct1, destaque: true },
    { chave: 'pix.r.acc',    nome: 'acurácia', get: m => m.acuracia, melhor: 'maior', fmt: fmtPct1 },
    { chave: 'pix.r.saques', nome: 'saques encontrados', get: m => m.saques, fmt: fmtInt },
    { chave: 'pix.r.erros',  nome: 'erros de IA', get: m => m.erros, melhor: 'menor', fmt: fmtInt },
  ] },
  { chave: 'pix.g.tempo', nome: 'Tempo', linhas: [
    { chave: 'pix.r.chegada', nome: 'chegada', get: m => m.chegada, melhor: 'menor', foraDoPlacar: true, fmt: v => v + 'º' },
    { chave: 'pix.r.total',   nome: 'tempo total', get: m => m.total, melhor: 'menor', fmt: fmtMs, destaque: true },
    { chave: 'pix.r.ia',      nome: 'tempo de IA (soma das decisões)', get: m => m.ia, melhor: 'menor', fmt: fmtMs },
    { chave: 'pix.r.grafo',   nome: 'tempo de grafo (soma dos rastreios)', get: m => m.grafo, fmt: fmtMs },
    { chave: 'pix.r.outros',  nome: 'outros (total − IA − grafo)', get: m => m.outros, fmt: fmtMs },
    { chave: 'pix.r.p50d',    nome: 'p50 decisão', get: m => m.p50d, melhor: 'menor', fmt: fmtMs, destaque: true },
    { chave: 'pix.r.mediad',  nome: 'média decisão', get: m => m.mediad, melhor: 'menor', fmt: fmtMs },
    { chave: 'pix.r.p50r',    nome: 'p50 rastreio', get: m => m.p50r, fmt: fmtMs },
    { chave: 'pix.r.mediar',  nome: 'média rastreio', get: m => m.mediar, fmt: fmtMs },
  ] },
  { chave: 'pix.g.custo', nome: 'Custo', linhas: [
    { chave: 'pix.r.capi',    nome: 'custo da API', get: m => m.custoApi, melhor: 'menor', fmt: fmtUSD },
    { chave: 'pix.r.cmaq',    nome: 'custo de máquina (estimado)', get: m => m.custoMaq, melhor: 'menor', fmt: fmtUSD, vazio: () => 'embutido na API' },
    { chave: 'pix.r.ctotal',  nome: 'custo total', get: m => m.custoTotal, melhor: 'menor', fmt: fmtUSD, destaque: true },
    { chave: 'pix.r.cmsg',    nome: 'custo por mensagem', get: m => m.custoMsg, melhor: 'menor', fmt: fmtUSD },
    { chave: 'pix.r.premissa',nome: 'premissa do custo', get: m => m.premissa, texto: true, fmt: v => v },
  ] },
  { chave: 'pix.g.tokens', nome: 'Tokens', linhas: [
    { chave: 'pix.r.tin',     nome: 'tokens de entrada', get: m => m.tokIn, melhor: 'menor', fmt: fmtInt },
    { chave: 'pix.r.tout',    nome: 'tokens de saída', get: m => m.tokOut, melhor: 'menor', fmt: fmtInt, vazio: () => 'não gera texto' },
    { chave: 'pix.r.tinmsg',  nome: 'entrada por mensagem', get: m => m.tokInMsg, melhor: 'menor', fmt: v => nf(v, 1) },
  ] },
  { chave: 'pix.g.memoria', nome: 'Memória', linhas: [
    { chave: 'pix.r.onde',    nome: 'onde roda o modelo', get: m => m.onde, texto: true,
      fmt: (v, m) => v === 'local' ? 'local na GPU' : 'no provedor (' + LADOS.find(l => l.id === m.k)!.onde + ')' },
    { chave: 'pix.r.ram',     nome: 'RAM do modelo', get: m => m.ram, melhor: 'menor', fmt: fmtMem, vazio: m => m.onde === 'local' ? '—' : 'no provedor' },
    { chave: 'pix.r.vram',    nome: 'VRAM do modelo', get: m => m.vram, melhor: 'menor', fmt: fmtMem, vazio: m => m.onde === 'local' ? '—' : 'no provedor' },
    { chave: 'pix.r.app',     nome: 'app Rust (os três lados)', app: true },
  ] },
];

// estrela só com ≥ 2 valores comparáveis e sem empate geral; placar por grupo (a chegada fica fora)
const relatorio = GRUPOS.map(g => {
  const pl: Record<string, number> = { jev: 0, deepseek: 0, laya: 0 };
  let comparaveis = 0;
  const linhas = g.linhas.map(li => {
    if (li.app) return { ...li, cels: [] as any[] };
    const vals = Object.fromEntries(LADOS.map(l => [l.id, li.get!(M[l.id])]));
    const nota = (id: string) => { const v = vals[id]; if (typeof v !== 'number' || Number.isNaN(v)) return null; return li.melhor === 'menor' ? v : li.melhor === 'maior' ? -v : null; };
    let venc: string[] = [];
    const validos = LADOS.map(l => l.id).filter(id => nota(id) != null);
    if (li.melhor && validos.length >= 2) {
      if (!li.foraDoPlacar) comparaveis++;
      const melhor = Math.min(...validos.map(id => nota(id)!));
      venc = validos.filter(id => nota(id) === melhor);
      if (venc.length === validos.length) venc = [];
      else if (!li.foraDoPlacar) venc.forEach(id => pl[id]++);
    }
    const cels = LADOS.map(l => {
      const v = vals[l.id];
      const vazio = v == null || (typeof v === 'number' && Number.isNaN(v));
      return { id: l.id, txt: vazio ? (li.vazio ? li.vazio(M[l.id]) : '—') : li.fmt!(v, M[l.id]), vencedor: venc.includes(l.id), vazio };
    });
    return { ...li, cels };
  });
  const max = comparaveis ? Math.max(...LADOS.map(l => pl[l.id])) : 0;
  const lideres = max > 0 ? LADOS.filter(l => pl[l.id] === max).map(l => l.id) : [];
  return { chave: g.chave, nome: g.nome, comparaveis, pl, lideres, linhas };
});
const appTxt = `${fmtMem(app.rss_mb)} de memória do processo, dos quais ${fmtMem(app.dados_mb)} de dados (grafo e contas) · um só processo, compartilhado pelos três lados`;
const nomeDe = (id: string) => LADOS.find(l => l.id === id)!.nome;

// ---------- tela final da corrida ----------
const porChegada = [...LADOS].sort((a, b) => pos(a.id) - pos(b.id));
const tela = Object.fromEntries(LADOS.map(l => {
  const ms = msgs(l.id);
  const ultimoGolpe = [...ms].reverse().find(e => e.golpe && e.rota && e.rotulo_golpe) ?? [...ms].reverse().find(e => e.golpe && e.rota);
  return [l.id, { ultimoGolpe, log: ms.slice(-8).reverse() }];
}));
const memModelo = (id: string) => M[id].onde === 'local'
  ? `${fmtMem(M[id].ram)} RAM + ${fmtMem(M[id].vram)} VRAM`
  : 'no provedor';

// ---------- as 150 mensagens, com a decisão de cada lado ----------
type Msg = { idx: number; msg_id: number; texto: string; remetente: string; destinatario: string; golpe: boolean; lados: Record<string, Ev> };
const porIdx = new Map<number, Msg>();
for (const e of eventos) {
  if (e.tipo !== 'mensagem') continue;
  const m = porIdx.get(e.idx) ?? { idx: e.idx, msg_id: e.msg_id, texto: e.texto, remetente: e.remetente, destinatario: e.destinatario_nome, golpe: !!e.rotulo_golpe, lados: {} };
  m.lados[e.lado] = e;
  porIdx.set(e.idx, m);
}
const mensagens = [...porIdx.values()].sort((a, b) => a.idx - b.idx);
const comErro = (m: Msg) => LADOS.some(l => m.lados[l.id] && m.lados[l.id].acertou === false);
const nComErro = mensagens.filter(comErro).length;
const rotaDe = (m: Msg) => { for (const l of LADOS) { const e = m.lados[l.id]; if (e?.rota) return e; } return null; };
const tipoTxt = (t?: string) => (t ? t.replaceAll('_', ' ') : '—');
const gravadoEm = new Date(C.gravado_em).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' });
---

<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark" data-lang="pt"
      data-title-pt="Lab Pix — Detector de Golpe do Pix · Eduardo Ritter"
      data-title-en="Pix Lab — Pix Fraud Detector · Eduardo Ritter">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lab Pix — Detector de Golpe do Pix · Eduardo Ritter</title>
  <meta name="description" content="JEV vs Gemini vs Laya, os três em Rust: 150 mensagens de WhatsApp, 15 golpes do Pix, rastreio do dinheiro até a conta de saque." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <script is:inline>
    (function () {
      var s = localStorage.getItem('theme');
      var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', s || (d ? 'dark' : 'light'));
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Display:wght@400;500&family=Google+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>

<body class="pg">

  <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

  <Nav base="/" />

  <main>

    <!-- ── Abertura ─────────────────────────────────────────────── -->
    <section class="section pg-abertura reveal-section" id="topo">
      <div class="container">
        <p class="label pg-eyebrow"><span data-i18n="pix.eyebrow">Lab · Detecção de golpe do Pix</span> · {gravadoEm}</p>
        <h1 class="pg-titulo">
          <span class="pg-c-jev">JEV</span> <em>vs</em>
          <span class="pg-c-deepseek">Gemini</span> <em>vs</em>
          <span class="pg-c-laya">Laya</span><span class="pg-titulo-rust"> · <span data-i18n="pix.title.rust">os três em Rust</span></span>
        </h1>
        <p class="pg-sub" data-i18n="pix.sub">O mesmo app em Rust roda os três lados; só o modelo de IA muda. As mesmas mensagens de WhatsApp entram nos três, na mesma ordem. Cada lado decide se é golpe e, quando é, rastreia o dinheiro num grafo de transações Pix, conta a conta, até a conta de saque.</p>
        <ul class="pg-chips">
          <li class="label">{fmtInt(dados.n_mensagens ?? total)} <span data-i18n="pix.chip.msgs">mensagens</span></li>
          <li class="label pg-chip-golpes"><span data-i18n="pix.chip.real">golpes reais</span>: {golpesReais}</li>
          <li class="label">{fmtInt(dados.n_contas)} <span data-i18n="pix.chip.accounts">contas</span></li>
          <li class="label">{fmtInt(dados.n_transacoes)} <span data-i18n="pix.chip.tx">transações Pix</span></li>
          <li class="label"><span data-i18n="pix.chip.app">app Rust</span>: {fmtMem(app.rss_mb)} ({fmtMem(app.dados_mb)} <span data-i18n="pix.chip.data">de dados</span>)</li>
          <li class="label pg-chip-alerta" data-i18n="pix.chip.synthetic">dados sintéticos</li>
        </ul>
      </div>
    </section>

    <!-- ── 01 Resumo ─────────────────────────────────────────────── -->
    <section class="section pg-resumo reveal-section" id="resumo">
      <div class="container">
        <header class="section-header">
          <span class="section-index">01</span>
          <h2 data-i18n="pix.summary.title">Resumo</h2>
        </header>

        <div class="pg-podio">
          {porChegada.map((l, i) => {
            const m = M[l.id];
            return (
              <article class={`pg-card pg-lado-${l.id} reveal-item`} style={`--delay: ${i * 0.08}s`}>
                <div class="pg-card-topo">
                  <span class="pg-posicao">{m.chegada}º</span>
                  <div>
                    <h3 class="pg-card-nome">{l.nome}</h3>
                    <p class="label">{l.modelo} · {l.onde}</p>
                  </div>
                </div>
                <div class="pg-card-tempo">
                  <span class="stat-num">{fmtMs(m.total)}</span>
                  <span class="label" data-i18n="pix.stat.total150">para 150 mensagens</span>
                </div>
                <dl class="pg-linhas">
                  <div><dt class="label" data-i18n="pix.r.p50d">p50 decisão</dt><dd>{fmtMs(m.p50d)}</dd></div>
                  <div><dt class="label" data-i18n="pix.stat.caught">Golpes pegos</dt><dd>{m.vp} / {m.reais}</dd></div>
                  <div><dt class="label" data-i18n="pix.stat.fp">Alarmes falsos</dt><dd>{m.fp}</dd></div>
                  <div><dt class="label" data-i18n="pix.r.prec">precisão</dt><dd>{fmtPct1(m.precisao)}</dd></div>
                  <div><dt class="label" data-i18n="pix.r.ctotal">custo total</dt><dd>{fmtUSD(m.custoTotal)}{m.custoMaq != null && <small class="pg-obs"> (<span data-i18n="pix.card.est">máquina, estimado</span>)</small>}</dd></div>
                  <div><dt class="label" data-i18n="pix.card.mem">memória do modelo</dt><dd>{memModelo(l.id)}</dd></div>
                </dl>
              </article>
            );
          })}
        </div>

        <p class="pg-veredito" data-i18n="pix.verdict">Com o mesmo app em Rust nos três lados, o grafo leva menos de meio milissegundo no total em qualquer um deles: <strong>a diferença vem toda do modelo</strong>. O <strong>Laya</strong>, local na GPU, terminou em 6 segundos e custou frações de centavo, mas errou mais: 12 alarmes falsos e 1 golpe perdido, com precisão de 54%. O <strong>JEV</strong> acertou as 150 mensagens em 78 segundos por menos de 1 centavo de dólar. O <strong>Gemini</strong>, um LLM generativo, também acertou tudo, mas levou 3 minutos e custou quase 10 vezes mais.</p>

        <div class="pg-acoes">
          <a class="btn-outline" href="#comparativo"><span data-i18n="pix.cta.table">Comparativo completo</span></a>
          <a class="btn-outline" href="#corrida"><span data-i18n="pix.cta.race">Ver a tela da corrida</span></a>
          <a class="btn-outline" href="#laya"><span data-i18n="pix.cta.laya">Por que o Laya erra</span></a>
          <a class="btn-outline" href="#mensagens"><span data-i18n="pix.cta.msgs">Ler as mensagens</span></a>
        </div>
      </div>
    </section>

    <!-- ── 02 Comparativo (relatório agrupado) ───────────────────── -->
    <section class="section reveal-section" id="comparativo">
      <div class="container">
        <header class="section-header">
          <span class="section-index">02</span>
          <h2 data-i18n="pix.table.title">Comparativo</h2>
        </header>
        <p class="label pg-exec">
          <span data-i18n="pix.table.run">execução</span> #{execucao.id ?? 1} · <span data-i18n="pix.table.mode">modo</span> {execucao.modo ?? 'normal'} ·
          <span data-i18n="pix.chip.real">golpes reais</span>: {golpesReais} · {LADOS.map(l => `${l.curto}: ${M[l.id].proc} msgs`).join(' · ')}
        </p>
        <div class="pg-placar-grupos">
          {relatorio.filter(g => g.comparaveis).map(g => (
            <span class="pg-placar-item">
              <span class="label" data-i18n={g.chave}>{g.nome}</span>
              {g.lideres.length === 1
                ? <b class={`pg-c-${g.lideres[0]}`}>{nomeDe(g.lideres[0])}</b>
                : <span class="pg-mudo"><span data-i18n="pix.table.tie">empate</span> {g.lideres.map(nomeDe).join(' e ')}</span>}
              <span class="pg-mono pg-placar-det">{LADOS.map((l, i) => <span class={`pg-c-${l.id}`}>{i > 0 && ' · '}{g.pl[l.id]}</span>)}</span>
            </span>
          ))}
        </div>
        <div class="pg-tabela-wrap">
          <table class="pg-tabela">
            <thead>
              <tr>
                <th class="label" data-i18n="pix.table.metric">Métrica</th>
                {LADOS.map(l => <th class={`label pg-c-${l.id}`}>{l.nome}</th>)}
              </tr>
            </thead>
            <tbody>
              {relatorio.map(g => (
                <Fragment>
                  <tr class="pg-grupo">
                    <th scope="rowgroup"><span data-i18n={g.chave}>{g.nome}</span>{!g.comparaveis && <small> · <span data-i18n="pix.table.info">informativo</span></small>}</th>
                    {LADOS.map(l => (
                      <td class={g.lideres.length === 1 && g.lideres[0] === l.id ? 'pg-grupo-lider' : ''}>{g.comparaveis ? (g.pl[l.id] ? '★ ' + g.pl[l.id] : '0') : ''}</td>
                    ))}
                  </tr>
                  {g.linhas.map((li: any) => li.app ? (
                    <tr class="pg-info"><th class="pg-metrica" data-i18n={li.chave}>{li.nome}</th><td colspan="3" class="pg-texto-cel">{appTxt}</td></tr>
                  ) : (
                    <tr class={[li.destaque ? 'pg-destaque' : '', li.melhor ? '' : 'pg-info'].filter(Boolean).join(' ')}>
                      <th class="pg-metrica" data-i18n={li.chave}>{li.nome}</th>
                      {li.cels.map((c: any) => (
                        <td class={[c.vencedor ? 'pg-melhor' : '', li.texto ? 'pg-texto-cel' : '', c.vazio ? 'pg-vazio' : ''].filter(Boolean).join(' ')}>{c.vencedor && <span class="pg-estrela" aria-label="melhor">★</span>}{c.txt}</td>
                      ))}
                    </tr>
                  ))}
                </Fragment>
              ))}
            </tbody>
          </table>
        </div>
        <p class="pg-nota" data-i18n="pix.table.note">★ = melhor da linha, só nas linhas comparáveis. O placar de cada grupo conta as ★ do grupo, sem misturar acerto, tempo, custo, tokens e memória. Linhas sem ★ são informativas: o rastreio no grafo é o mesmo código Rust nos três lados, e custo de máquina e memória do modelo só existem no lado local (nos lados de API ficam embutidos no provedor).</p>
      </div>
    </section>

    <!-- ── 03 A corrida (tela final salva) ───────────────────────── -->
    <section class="section reveal-section" id="corrida">
      <div class="container pg-container-largo">
        <header class="section-header">
          <span class="section-index">03</span>
          <h2 data-i18n="pix.race.title">A corrida</h2>
        </header>
        <p class="pg-sub pg-sub-curto" data-i18n="pix.race.sub">A tela como ficou no fim da execução, no modo normal: cada lado pega a próxima mensagem assim que termina a anterior.</p>

        <div class="pg-corrida">
          {LADOS.map(l => {
            const m = M[l.id]; const t = tela[l.id]; const g = t.ultimoGolpe;
            return (
              <article class={`pg-coluna pg-lado-${l.id}`}>
                <div class="pg-col-cab">
                  <div>
                    <h3 class="pg-card-nome">{l.nome}</h3>
                    <p class="label">{l.onde}</p>
                  </div>
                  <span class={`pg-selo pg-selo-${m.chegada}`}>{m.chegada}º · {fmtMs(m.total)}</span>
                </div>
                <div class="pg-chipzinhos">
                  <span class="pg-mono">{ladosInfo[l.id]?.modelo}</span>
                  <span class="pg-mono">{memModelo(l.id)}</span>
                </div>

                <div class="pg-progresso">
                  <div class="pg-progresso-num"><strong>{m.proc}</strong> / {total}</div>
                  <div class="pg-barra"><span style="width:100%"></span></div>
                </div>

                <div class="pg-contadores">
                  <div><span class="label" data-i18n="pix.c.sinal">sinalizados</span><b>{m.sinal}</b></div>
                  <div><span class="label" data-i18n="pix.c.vp">golpes pegos</span><b>{m.vp}/{m.reais}</b></div>
                  <div><span class="label" data-i18n="pix.c.fp">alarmes falsos</span><b>{m.fp}</b></div>
                  <div><span class="label" data-i18n="pix.c.prec">precisão</span><b>{fmtPct1(m.precisao)}</b></div>
                  <div><span class="label" data-i18n="pix.c.cob">cobertura</span><b>{fmtPct1(m.cobertura)}</b></div>
                  <div><span class="label" data-i18n="pix.c.custo">custo total</span><b>{fmtUSD(m.custoTotal)}</b></div>
                  <div><span class="label" data-i18n="pix.race.decisao">decisão p50</span><b>{fmtMs(m.p50d)}</b></div>
                  <div><span class="label" data-i18n="pix.race.rastreio">rastreio p50</span><b>{fmtMs(m.p50r)}</b></div>
                  <div><span class="label" data-i18n="pix.race.tempo">tempo</span><b>{fmtMs(m.total)}</b></div>
                </div>

                {g && (
                  <div class="pg-msg">
                    <p class="label"><span data-i18n="pix.race.lastscam">Último golpe rastreado</span> · msg #{g.msg_id}</p>
                    <p class="pg-msg-meta pg-mono">{g.remetente} → {g.destinatario_nome}</p>
                    <blockquote>{g.texto}</blockquote>
                    <div class="pg-decisao">
                      <span class="pg-badge-golpe" data-i18n="pix.race.scam">GOLPE</span>
                      <span class="pg-mono">prob. {fmtPct1(g.prob)} · {tipoTxt(g.tipo_golpe)} · {fmtMs(g.t_decisao_ms)}</span>
                    </div>
                  </div>
                )}

                {g && g.rota && (
                  <div class="pg-rota">
                    <p class="label"><span data-i18n="pix.race.route">Rota do dinheiro</span> · {g.rota.saque_encontrado ? `saque em ${g.rota.hops} hops` : `${g.rota.hops} hops, sem saque`}</p>
                    <ol>
                      {g.rota.nos.map((n: any, i: number) => {
                        const a = g.rota.arestas[i];
                        const ultimo = i === g.rota.nos.length - 1;
                        return (
                          <li class={`pg-no ${ultimo && n.tipo === 'caixa' ? 'pg-no-saque' : ''}`}>
                            <span class="pg-no-ponto" aria-hidden="true"></span>
                            <div class="pg-no-txt">
                              <span class="label">{i === 0 ? 'destino' : (ultimo && n.tipo === 'caixa' ? 'saque' : `hop ${i}`)}</span>
                              <span class="pg-no-nome">{n.nome}</span>
                              <span class="pg-no-banco">{n.banco}</span>
                            </div>
                            {a && <span class="pg-aresta pg-mono">{fmtBRL(a.valor_centavos)} · {fmtDelta(a.ts - g.ts_msg)}</span>}
                          </li>
                        );
                      })}
                    </ol>
                  </div>
                )}

                <div class="pg-log">
                  <p class="label" data-i18n="pix.race.log">Últimas mensagens</p>
                  <ul>
                    {t.log.map((e: any) => (
                      <li>
                        <details>
                          <summary>
                            <span class="pg-mono pg-log-idx">{e.idx}</span>
                            <span class={e.golpe ? 'pg-log-golpe' : 'pg-log-legit'}>{e.golpe ? 'GOLPE' : 'LEGÍTIMA'} {fmtPct1(e.prob)}</span>
                            <span class="pg-mono pg-log-ms">{fmtMs(e.t_decisao_ms)}</span>
                            <span class={e.acertou ? 'pg-ok' : 'pg-erro'}>{e.acertou ? '✓' : '✗'}</span>
                          </summary>
                          <p class="pg-log-texto">{e.texto}</p>
                        </details>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ── 04 Como funciona ──────────────────────────────────────── -->
    <section class="section reveal-section" id="como-funciona">
      <div class="container">
        <header class="section-header">
          <span class="section-index">04</span>
          <h2 data-i18n="pix.how.title">Como funciona</h2>
        </header>
        <ol class="pg-passos">
          <li><span class="stat-num">1</span><div><h3 data-i18n="pix.how.s1.t">Decisão por IA</h3><p data-i18n="pix.how.s1.d">O único passo que muda entre os lados. O JEV (API TypeSafe) e o Laya (local, na GPU) respondem perguntas tipadas com probabilidade: é golpe? tem urgência? qual o tipo? O LLM generativo responde um JSON.</p></div></li>
          <li><span class="stat-num">2</span><div><h3 data-i18n="pix.how.s2.t">Chave Pix</h3><p data-i18n="pix.how.s2.d">Em código, sem IA: a chave Pix citada no texto (CPF, CNPJ, telefone, e-mail ou aleatória) é extraída, normalizada e ligada à conta de destino.</p></div></li>
          <li><span class="stat-num">3</span><div><h3 data-i18n="pix.how.s3.t">Grafo em memória</h3><p data-i18n="pix.how.s3.d">As transações ficam num grafo CSR em Rust, compartilhado pelos três lados: cada conta é um nó e cada Pix é uma aresta com valor e instante. São 8 MB para 500 mil transações.</p></div></li>
          <li><span class="stat-num">4</span><div><h3 data-i18n="pix.how.s4.t">Rastreio até o saque</h3><p data-i18n="pix.how.s4.d">A partir da conta de destino, segue sempre o maior repasse numa janela de 72 horas, laranja a laranja, até chegar a uma conta de saque. Leva cerca de 14 microssegundos por golpe.</p></div></li>
        </ol>

        <div class="pg-ressalvas">
          <p class="label" data-i18n="pix.caveats.title">Ressalvas</p>
          <ul>
            <li data-i18n="pix.caveats.1">Dados 100% sintéticos, gerados localmente. Chaves Pix e nomes aparecem mascarados.</li>
            <li data-i18n="pix.caveats.2">O vídeo original compara com o DeepSeek. Aqui o LLM generativo é o Gemini 2.5 Flash, do Google, porque não havia chave do DeepSeek. O código é o mesmo: com a chave, o lado volta a ser DeepSeek sem mudar nada.</li>
            <li data-i18n="pix.caveats.3">O Laya usou uma pergunta curta. Com as perguntas longas do JEV ele marcava todas as mensagens como golpe.</li>
            <li data-i18n="pix.caveats.5">O custo de máquina do Laya é uma estimativa: tempo do modelo vezes US$ 0,35 por hora de uma GPU T4 na nuvem. Nos lados de API, máquina e memória do modelo ficam no provedor e não são medidas.</li>
            <li data-i18n="pix.caveats.6">Numa rodada anterior, com o Gemini e o Laya rodando em Python, os tempos foram praticamente os mesmos (3:00 min e 7,2 s): o gargalo é o modelo, não a linguagem.</li>
            <li data-i18n="pix.caveats.4">As perguntas foram ajustadas nestas mesmas mensagens, então o acerto de 100% não é uma promessa para dados novos.</li>
          </ul>
          <p class="pg-nota"><span data-i18n="pix.credits">Inspirado no vídeo do Sandeco:</span> <a class="link-item" href="https://www.youtube.com/watch?v=avQAz9norY8" target="_blank" rel="noopener">JEV+RUST: Detectando fraudes no Pix em tempo real</a></p>
        </div>
      </div>
    </section>

    <!-- ── 05 Por que o Laya erra (testes de alarme falso, feitos depois da corrida) ── -->
    <section class="section reveal-section" id="laya">
      <div class="container">
        <header class="section-header">
          <span class="section-index">05</span>
          <h2 data-i18n="pix.exp.title">Por que o Laya erra</h2>
        </header>
        <p class="pg-sub pg-sub-curto" data-i18n="pix.exp.intro">Depois da corrida, testamos se uma instrução melhor ou exemplos acabariam com os alarmes falsos do Laya. Cada versão da pergunta rodou nas 150 mensagens e em 30 mensagens novas, escritas à mão, que nenhum modelo tinha visto (15 golpes e 15 legítimas).</p>

        <div class="pg-tabela-wrap">
          <table class="pg-tabela pg-tabela-exp">
            <thead>
              <tr>
                <th class="label" data-i18n="pix.exp.col.q">Quem e com que pergunta</th>
                <th class="label" data-i18n="pix.exp.col.150">150 de sempre · golpes pegos · alarmes falsos</th>
                <th class="label" data-i18n="pix.exp.col.30">30 novas · golpes pegos · alarmes falsos</th>
              </tr>
            </thead>
            <tbody>
              <tr><th class="pg-metrica"><span class="pg-c-laya">Laya</span> · <span data-i18n="pix.exp.v1">pergunta curta, a da corrida</span></th><td>14/15 · 12</td><td class="pg-ruim">9/15 · 2</td></tr>
              <tr><th class="pg-metrica"><span class="pg-c-laya">Laya</span> · <span data-i18n="pix.exp.v2">instrução melhor (o que é golpe e o que é cobrança legítima)</span></th><td class="pg-ruim">15/15 · 102</td><td class="pg-ruim">15/15 · 13</td></tr>
              <tr><th class="pg-metrica"><span class="pg-c-laya">Laya</span> · <span data-i18n="pix.exp.v3">instrução melhor + exemplos</span></th><td class="pg-ruim">12/15 · 47</td><td>12/15 · 6</td></tr>
              <tr><th class="pg-metrica"><span class="pg-c-laya">Laya</span> · <span data-i18n="pix.exp.v4">escolha entre 3 opções (golpe, cobrança, conversa)</span></th><td class="pg-ruim">13/15 · 32</td><td class="pg-ruim">9/15 · 8</td></tr>
              <tr><th class="pg-metrica"><span class="pg-c-laya">Laya</span> · <span data-i18n="pix.exp.v5">escolha + exemplos</span></th><td class="pg-ruim">6/15 · 55</td><td>12/15 · 8</td></tr>
              <tr class="pg-destaque"><th class="pg-metrica"><span class="pg-c-jev">JEV</span> · <span data-i18n="pix.exp.vjev">pergunta da corrida</span></th><td class="pg-melhor">15/15 · 0</td><td class="pg-melhor">15/15 · 0</td></tr>
              <tr class="pg-destaque"><th class="pg-metrica"><span class="pg-c-deepseek">Gemini</span> · <span data-i18n="pix.exp.vjev">pergunta da corrida</span></th><td class="pg-melhor">15/15 · 0</td><td class="pg-melhor">15/15 · 0</td></tr>
            </tbody>
          </table>
        </div>

        <ol class="pg-passos pg-achados">
          <li><span class="stat-num">1</span><div><h3 data-i18n="pix.exp.a1.t">Exemplos viram parte da mensagem</h3><p data-i18n="pix.exp.a1.d">Colocados junto do texto, os exemplos de golpe contaminam tudo: a nota mediana de golpe das mensagens legítimas subiu de 0,00 para 0,54, e até a mensagem "ok" ao lado dos exemplos levou 0,58. Um LLM usa exemplos como referência; o Laya julga tudo o que recebe como se fosse a própria mensagem.</p></div></li>
          <li><span class="stat-num">2</span><div><h3 data-i18n="pix.exp.a2.t">Ele reage ao assunto, não ao fato</h3><p data-i18n="pix.exp.a2.d">Com perguntas pequenas, ele respondeu "sim" para fatos que não estão no texto: "o remetente diz ser banco ou órgão?" deu 1,00 numa mensagem sobre aula de violão. Palavras de dinheiro (Pix, valor, pagar) puxam a nota para golpe, por isso venda combinada, aluguel e consulta viram alarme falso.</p></div></li>
          <li><span class="stat-num">3</span><div><h3 data-i18n="pix.exp.a3.t">Instrução melhor só muda o ponto do erro</h3><p data-i18n="pix.exp.a3.d">Explicar o que é golpe fez o Laya marcar quase tudo como golpe (102 alarmes falsos); os exemplos reduziram os alarmes mas ele passou a perder golpes. Nas 30 mensagens novas, a pergunta da corrida deixou passar 6 de 15 golpes, como falsos avisos do INSS, do Detran e da central do banco.</p></div></li>
          <li><span class="stat-num">4</span><div><h3 data-i18n="pix.exp.a4.t">Conclusão: é o modelo, não o prompt</h3><p data-i18n="pix.exp.a4.d">O JEV e o Gemini acertaram as 30 mensagens novas com a mesma pergunta de sempre, então elas não eram difíceis demais. O Laya, pequeno e sem treino, precisa ser treinado com exemplos rotulados, ou usado como filtro rápido com o JEV confirmando os casos suspeitos.</p></div></li>
        </ol>
        <p class="pg-nota" data-i18n="pix.exp.nota">30 mensagens é pouco para números exatos, mas a diferença entre 15 de 15 e 9 de 15 golpes pegos é grande demais para ser acaso. Todos os testes do Laya rodaram localmente, sem custo.</p>
      </div>
    </section>

    <!-- ── 06 As mensagens (todas, expansíveis) ──────────────────── -->
    <section class="section reveal-section" id="mensagens">
      <div class="container">
        <header class="section-header">
          <span class="section-index">06</span>
          <h2 data-i18n="pix.msgs.title">As mensagens</h2>
        </header>
        <p class="pg-sub pg-sub-curto" data-i18n="pix.msgs.sub">Clique numa mensagem para ler o texto inteiro, ver a decisão de cada lado e a rota do dinheiro quando houve rastreio.</p>

        <div class="pg-filtros" role="group" aria-label="Filtrar mensagens">
          <button type="button" class="pg-filtro is-on" data-filtro="todas"><span data-i18n="pix.msgs.all">Todas</span> <b>{mensagens.length}</b></button>
          <button type="button" class="pg-filtro" data-filtro="golpe"><span data-i18n="pix.msgs.scams">Golpes reais</span> <b>{golpesReais}</b></button>
          <button type="button" class="pg-filtro" data-filtro="erro"><span data-i18n="pix.msgs.errors">Com erro de algum lado</span> <b>{nComErro}</b></button>
        </div>
        <p class="pg-legenda label">
          <span class="pg-c-jev">■ JEV + Rust</span> · <span class="pg-c-deepseek">■ Gemini + Rust</span> · <span class="pg-c-laya">■ Laya + Rust</span> · ✓ <span data-i18n="pix.msgs.right">acertou</span> · ✗ <span data-i18n="pix.msgs.wrong">errou</span>
        </p>

        <ol class="pg-msgs">
          {mensagens.map(m => {
            const r = rotaDe(m);
            return (
              <li data-golpe={m.golpe ? '1' : '0'} data-erro={comErro(m) ? '1' : '0'}>
                <details>
                  <summary>
                    <span class="pg-mono pg-msgs-idx">#{m.msg_id}</span>
                    <span class={m.golpe ? 'pg-tag pg-tag-golpe' : 'pg-tag pg-tag-legit'} data-i18n={m.golpe ? 'pix.msgs.tag.scam' : 'pix.msgs.tag.legit'}>{m.golpe ? 'golpe' : 'legítima'}</span>
                    <span class="pg-msgs-previa">{m.texto}</span>
                    <span class="pg-msgs-lados">
                      {LADOS.map(l => { const e = m.lados[l.id]; return <span class={`pg-marca pg-c-${l.id}${e?.acertou ? '' : ' pg-marca-erro'}`} title={l.nome}>{e?.acertou ? '✓' : '✗'}</span>; })}
                    </span>
                  </summary>
                  <div class="pg-msgs-corpo">
                    <p class="pg-msg-meta pg-mono">{m.remetente} → {m.destinatario}</p>
                    <blockquote class={m.golpe ? '' : 'pg-bq-legit'}>{m.texto}</blockquote>
                    <div class="pg-msgs-grade">
                      {LADOS.map(l => {
                        const e = m.lados[l.id];
                        if (!e) return <div class={`pg-msgs-lado pg-lado-${l.id}`}><b>{l.nome}</b><span>—</span></div>;
                        return (
                          <div class={`pg-msgs-lado pg-lado-${l.id}`}>
                            <b class={`pg-c-${l.id}`}>{l.nome}</b>
                            <span class={e.golpe ? 'pg-log-golpe' : 'pg-log-legit'}>{e.golpe ? 'GOLPE' : 'LEGÍTIMA'} · {fmtPct1(e.prob)}</span>
                            <span class="pg-mono">{tipoTxt(e.tipo_golpe)} · {fmtMs(e.t_decisao_ms)}{e.tokens_in != null ? ` · ${fmtInt(e.tokens_in)} tokens` : ''}</span>
                            <span class={e.acertou ? 'pg-ok' : 'pg-erro'}>{e.acertou ? '✓ acertou' : '✗ errou'}</span>
                            {e.rota && <span class="pg-mono pg-msgs-rota">{e.rota.saque_encontrado ? `saque em ${e.rota.hops} hops` : `${e.rota.hops} hops, sem saque`}</span>}
                          </div>
                        );
                      })}
                    </div>
                    {r && (
                      <div class="pg-rota pg-rota-inline">
                        <p class="label"><span data-i18n="pix.race.route">Rota do dinheiro</span> · {r.rota.saque_encontrado ? `saque em ${r.rota.hops} hops` : `${r.rota.hops} hops, sem saque`}</p>
                        <ol>
                          {r.rota.nos.map((n: any, i: number) => {
                            const a = r.rota.arestas[i];
                            const ultimo = i === r.rota.nos.length - 1;
                            return (
                              <li class={`pg-no ${ultimo && n.tipo === 'caixa' ? 'pg-no-saque' : ''}`}>
                                <span class="pg-no-ponto" aria-hidden="true"></span>
                                <div class="pg-no-txt">
                                  <span class="label">{i === 0 ? 'destino' : (ultimo && n.tipo === 'caixa' ? 'saque' : `hop ${i}`)}</span>
                                  <span class="pg-no-nome">{n.nome}</span>
                                  <span class="pg-no-banco">{n.banco}</span>
                                </div>
                                {a && <span class="pg-aresta pg-mono">{fmtBRL(a.valor_centavos)} · {fmtDelta(a.ts - r.ts_msg)}</span>}
                              </li>
                            );
                          })}
                        </ol>
                      </div>
                    )}
                  </div>
                </details>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

  </main>

  <Footer />

  <script>
    import '../scripts/main.js';

    // Filtro da lista de mensagens: todas / golpes reais / com erro de algum lado
    const filtros = document.querySelectorAll<HTMLButtonElement>('.pg-filtro');
    filtros.forEach(b => b.addEventListener('click', () => {
      filtros.forEach(x => x.classList.toggle('is-on', x === b));
      const f = b.dataset.filtro;
      document.querySelectorAll<HTMLLIElement>('.pg-msgs > li').forEach(li => {
        li.hidden = f === 'golpe' ? li.dataset.golpe !== '1' : f === 'erro' ? li.dataset.erro !== '1' : false;
      });
    }));
  </script>

</body>
</html>

<style is:global>
  /* Cores dos três lados, derivadas do site: dourado do accent, aço e lavanda discretos */
  [data-theme="dark"] .pg  { --lado-jev: #c9a96e; --lado-deepseek: #8fa6c4; --lado-laya: #b3a0d8; --golpe: #d9776b; --legit: #8fb89a; }
  [data-theme="light"] .pg { --lado-jev: #9c7a3c; --lado-deepseek: #4a6a92; --lado-laya: #6e56a8; --golpe: #b0463a; --legit: #3f7a52; }

  .pg-c-jev   { color: var(--lado-jev); }
