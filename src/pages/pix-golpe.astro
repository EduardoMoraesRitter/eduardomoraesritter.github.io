---
// src/pages/pix-golpe.astro
// ──────────────────────────
// Lab Pix — resultado salvo da corrida "Detector de Golpe do Pix":
// JEV + Rust vs DeepSeek + Python vs Laya + Python. Tudo é estático: os números vêm do snapshot
// gravado da execução real (src/data/pix-golpe/corrida.json) e são calculados no build.
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import corrida from '../data/pix-golpe/corrida.json';

import '../styles/global.css';

type Ev = any;
const eventos: Ev[] = (corrida as any).eventos;

const LADOS = [
  { id: 'rust',   nome: 'JEV + Rust',        stack: 'TypeSafe JEV · Rust',        detalhe: 'API TypeSafe · grafo CSR em Vec<u32>' },
  { id: 'python', nome: 'DeepSeek + Python', stack: 'LLM generativo · Python',    detalhe: 'Gemini 2.5 Flash no lugar do DeepSeek · listas Python' },
  { id: 'laya',   nome: 'Laya + Python',     stack: 'Convai Laya · Python · GPU', detalhe: 'modelo aberto, local numa RTX 4070 · listas Python' },
] as const;

const fins: Record<string, Ev> = Object.fromEntries(
  LADOS.map(l => [l.id, eventos.find(e => e.tipo === 'fim' && e.lado === l.id)])
);
const ordem = eventos.filter(e => e.tipo === 'fim').sort((a, b) => a.seq - b.seq).map(e => e.lado);
const pos = (id: string) => ordem.indexOf(id) + 1;
const msgs = (id: string) => eventos.filter(e => e.tipo === 'mensagem' && e.lado === id).sort((a, b) => a.idx - b.idx);
const ladosInfo = (corrida as any).lados ?? {};
const dados = (corrida as any).dados ?? {};

// ---------- formatação pt-BR ----------
const nf = (v: number, d = 0) => v.toLocaleString('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d });
function fmtMs(ms: number | null | undefined) {
  if (ms == null) return '—';
  if (ms < 1) return nf(ms * 1000) + ' µs';
  if (ms < 10) return nf(ms, 1) + ' ms';
  if (ms < 1000) return nf(ms) + ' ms';
  return nf(ms / 1000, 1) + ' s';
}
function fmtTotal(ms: number) {
  if (ms < 60000) return nf(ms / 1000, 1) + ' s';
  const s = Math.floor(ms / 1000);
  return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0') + ' min';
}
const fmtUSD = (v: number) => 'US$ ' + nf(v, 4);
const fmtMem = (mb: number) => (mb >= 1024 ? nf(mb / 1024, 1) + ' GB' : nf(mb) + ' MB');
const fmtBRL = (c: number) => 'R$ ' + nf(c / 100, 2);
function fmtDelta(seg: number) {
  const a = Math.abs(seg);
  if (a < 3600) return '+' + Math.round(a / 60) + ' min';
  if (a < 86400) return '+' + nf(a / 3600, 1) + ' h';
  return '+' + nf(a / 86400, 1) + ' d';
}
const pct = (v: number) => nf(v * 100) + '%';

// ---------- números por lado ----------
const total = fins.rust.processadas;
const golpesReais = fins.rust.golpes_reais;
const stats = Object.fromEntries(LADOS.map(l => {
  const f = fins[l.id];
  const acertos = f.processadas - f.falsos_positivos - f.falsos_negativos;
  const memExtra = l.id === 'laya' && ladosInfo.laya?.vram_mb ? ' + ' + fmtMem(ladosInfo.laya.vram_mb) + ' GPU' : '';
  return [l.id, { f, acertos, taxa: acertos / f.processadas, memTxt: fmtMem(f.mem_mb) + memExtra }];
}));

// ---------- tabela comparativa (estrela no melhor de cada linha) ----------
// Mesmas linhas e mesmo critério do relatório final do app: estrela no melhor de cada linha
// (sem estrela quando os três empatam); "chegada" ganha estrela mas fica fora do placar;
// mensagens processadas e tokens são só informativos.
type Linha = {
  chave: string; rotulo: string; val: (id: string) => number;
  fmt: (v: number, id: string) => string; melhor: 'min' | 'max' | null; placar?: boolean;
};
const linhas: Linha[] = [
  { chave: 'pix.row.arrival',   rotulo: 'chegada',                 val: pos,                                  fmt: v => v + 'º',                        melhor: 'min', placar: false },
  { chave: 'pix.row.total',     rotulo: 'tempo total',             val: id => fins[id].total_ms,              fmt: v => fmtTotal(v),                    melhor: 'min' },
  { chave: 'pix.row.p50dec',    rotulo: 'p50 decisão',             val: id => fins[id].p50_decisao_ms,        fmt: v => fmtMs(v),                       melhor: 'min' },
  { chave: 'pix.row.avgdec',    rotulo: 'média decisão',           val: id => fins[id].media_decisao_ms,      fmt: v => fmtMs(v),                       melhor: 'min' },
  { chave: 'pix.row.p50tr',     rotulo: 'p50 rastreio',            val: id => fins[id].p50_rastreio_ms,       fmt: v => fmtMs(v),                       melhor: 'min' },
  { chave: 'pix.row.avgtr',     rotulo: 'média rastreio',          val: id => fins[id].media_rastreio_ms,     fmt: v => fmtMs(v),                       melhor: 'min' },
  { chave: 'pix.row.detected',  rotulo: 'golpes detectados / reais', val: id => Math.abs(fins[id].golpes_detectados - fins[id].golpes_reais),
                                                                   fmt: (_v, id) => fins[id].golpes_detectados + ' / ' + fins[id].golpes_reais, melhor: 'min' },
  { chave: 'pix.row.tp',        rotulo: 'verdadeiros positivos',   val: id => fins[id].verdadeiros_positivos, fmt: v => String(v),                      melhor: 'max' },
  { chave: 'pix.row.fp',        rotulo: 'falsos positivos',        val: id => fins[id].falsos_positivos,      fmt: v => String(v),                      melhor: 'min' },
  { chave: 'pix.row.fn',        rotulo: 'falsos negativos',        val: id => fins[id].falsos_negativos,      fmt: v => String(v),                      melhor: 'min' },
  { chave: 'pix.row.cashout',   rotulo: 'saques encontrados',      val: id => fins[id].saques_encontrados,    fmt: v => String(v),                      melhor: 'max' },
  { chave: 'pix.row.cost',      rotulo: 'custo',                   val: id => fins[id].custo_usd,             fmt: v => fmtUSD(v),                      melhor: 'min' },
  { chave: 'pix.row.mem',       rotulo: 'memória (RSS)',           val: id => fins[id].mem_mb,                fmt: (_v, id) => stats[id].memTxt,        melhor: 'min' },
  { chave: 'pix.row.errors',    rotulo: 'erros',                   val: id => fins[id].erros ?? 0,            fmt: v => String(v),                      melhor: 'min' },
  { chave: 'pix.row.processed', rotulo: 'mensagens processadas',   val: id => fins[id].processadas,           fmt: v => nf(v),                          melhor: null },
  { chave: 'pix.row.tokens',    rotulo: 'tokens (entrada / saída)', val: id => fins[id].tokens_in ?? 0,
                                                                   fmt: (_v, id) => nf(fins[id].tokens_in ?? 0) + ' / ' + nf(fins[id].tokens_out ?? 0), melhor: null },
];
const vencedores = (l: Linha): Set<string> => {
  if (!l.melhor) return new Set();
  const vs = LADOS.map(x => l.val(x.id));
  const alvo = l.melhor === 'min' ? Math.min(...vs) : Math.max(...vs);
  return new Set(LADOS.filter(x => l.val(x.id) === alvo).map(x => x.id));
};
// estrela só quando há diferença entre os lados
const estrelas = (l: Linha): Set<string> => { const v = vencedores(l); return v.size === LADOS.length ? new Set() : v; };
const linhasPlacar = linhas.filter(l => l.melhor && l.placar !== false);
const placar = Object.fromEntries(LADOS.map(l => [l.id, linhasPlacar.filter(li => { const v = vencedores(li); return v.size === 1 && v.has(l.id); }).length]));
const empates = linhasPlacar.filter(li => vencedores(li).size > 1).length;
const placarOrdenado = [...LADOS].sort((a, b) => placar[b.id] - placar[a.id]);
const execucao = (corrida as any).execucao ?? {};

// ---------- as 150 mensagens, com a decisão de cada lado ----------
type Msg = { idx: number; msg_id: number; texto: string; remetente: string; destinatario: string; golpe: boolean; lados: Record<string, Ev> };
const porIdx = new Map<number, Msg>();
for (const e of eventos) {
  if (e.tipo !== 'mensagem') continue;
  const m = porIdx.get(e.idx) ?? { idx: e.idx, msg_id: e.msg_id, texto: e.texto, remetente: e.remetente, destinatario: e.destinatario_nome, golpe: !!e.rotulo_golpe, lados: {} };
  m.lados[e.lado] = e;
  porIdx.set(e.idx, m);
}
const mensagens = [...porIdx.values()].sort((a, b) => a.idx - b.idx);
const comErro = (m: Msg) => LADOS.some(l => m.lados[l.id] && m.lados[l.id].acertou === false);
const nGolpesMsgs = mensagens.filter(m => m.golpe).length;
const nComErro = mensagens.filter(comErro).length;
const rotaDe = (m: Msg) => { for (const l of LADOS) { const e = m.lados[l.id]; if (e?.rota) return e; } return null; };
const tipoTxt = (t?: string) => (t ? t.replaceAll('_', ' ') : '—');

// ---------- tela final da corrida ----------
const porChegada = [...LADOS].sort((a, b) => pos(a.id) - pos(b.id));
const tela = Object.fromEntries(LADOS.map(l => {
  const ms = msgs(l.id);
  const ultimoGolpe = [...ms].reverse().find(e => e.golpe && e.rota && e.rotulo_golpe) ?? [...ms].reverse().find(e => e.golpe && e.rota);
  const log = ms.slice(-8).reverse();
  const golpesDetectados = ms.filter(e => e.golpe).length;
  return [l.id, { ultimoGolpe, log, golpesDetectados }];
}));
const modeloTxt = (id: string) => {
  const i = ladosInfo[id] ?? {};
  return [i.modelo, i.dispositivo].filter(Boolean).join(' · ');
};
const gravadoEm = new Date((corrida as any).gravado_em).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' });
---

<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark" data-lang="pt"
      data-title-pt="Lab Pix — Detector de Golpe do Pix · Eduardo Ritter"
      data-title-en="Pix Lab — Pix Fraud Detector · Eduardo Ritter">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lab Pix — Detector de Golpe do Pix · Eduardo Ritter</title>
  <meta name="description" content="JEV + Rust vs DeepSeek + Python vs Laya + Python: 150 mensagens de WhatsApp, 15 golpes do Pix, rastreio do dinheiro até a conta de saque." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <script is:inline>
    (function () {
      var s = localStorage.getItem('theme');
      var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', s || (d ? 'dark' : 'light'));
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Display:wght@400;500&family=Google+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>

<body class="pg">

  <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

  <Nav base="/" />

  <main>

    <!-- ── Abertura ─────────────────────────────────────────────── -->
    <section class="section pg-abertura reveal-section" id="topo">
      <div class="container">
        <p class="label pg-eyebrow"><span data-i18n="pix.eyebrow">Lab · Detecção de golpe do Pix</span> · {gravadoEm}</p>
        <h1 class="pg-titulo">
          <span class="pg-c-rust">JEV + Rust</span> <em>vs</em>
          <span class="pg-c-python">DeepSeek + Python</span> <em>vs</em>
          <span class="pg-c-laya">Laya + Python</span>
        </h1>
        <p class="pg-sub" data-i18n="pix.sub">As mesmas mensagens de WhatsApp entram nos três lados, na mesma ordem. Cada lado decide com IA se é golpe e, quando é, rastreia o dinheiro num grafo de transações Pix, conta a conta, até a conta de saque.</p>
        <ul class="pg-chips">
          <li class="label">{nf(dados.n_mensagens ?? total)} <span data-i18n="pix.chip.msgs">mensagens</span></li>
          <li class="label">{golpesReais} <span data-i18n="pix.chip.scams">golpes</span></li>
          <li class="label">{nf(dados.n_contas)} <span data-i18n="pix.chip.accounts">contas</span></li>
          <li class="label">{nf(dados.n_transacoes)} <span data-i18n="pix.chip.tx">transações Pix</span></li>
          <li class="label pg-chip-alerta" data-i18n="pix.chip.synthetic">dados sintéticos</li>
        </ul>
      </div>
    </section>

    <!-- ── 01 Resumo ─────────────────────────────────────────────── -->
    <section class="section pg-resumo reveal-section" id="resumo">
      <div class="container">
        <header class="section-header">
          <span class="section-index">01</span>
          <h2 data-i18n="pix.summary.title">Resumo</h2>
        </header>

        <div class="pg-podio">
          {porChegada.map((l, i) => {
            const s = stats[l.id]; const f = s.f;
            return (
              <article class={`pg-card pg-lado-${l.id} reveal-item`} style={`--delay: ${i * 0.08}s`}>
                <div class="pg-card-topo">
                  <span class="pg-posicao">{pos(l.id)}º</span>
                  <div>
                    <h3 class="pg-card-nome">{l.nome}</h3>
                    <p class="label">{l.stack}</p>
                  </div>
                </div>
                <div class="pg-card-tempo">
                  <span class="stat-num">{fmtTotal(f.total_ms)}</span>
                  <span class="label" data-i18n="pix.stat.total150">para 150 mensagens</span>
                </div>
                <dl class="pg-linhas">
                  <div><dt class="label" data-i18n="pix.stat.decision">Decisão (mediana)</dt><dd>{fmtMs(f.p50_decisao_ms)}</dd></div>
                  <div><dt class="label" data-i18n="pix.stat.caught">Golpes pegos</dt><dd>{f.verdadeiros_positivos} / {golpesReais}</dd></div>
                  <div><dt class="label" data-i18n="pix.stat.fp">Alarmes falsos</dt><dd>{f.falsos_positivos}</dd></div>
                  <div><dt class="label" data-i18n="pix.stat.cost">Custo da corrida</dt><dd>{fmtUSD(f.custo_usd)}</dd></div>
                  <div><dt class="label" data-i18n="pix.stat.mem">Memória</dt><dd>{s.memTxt}</dd></div>
                </dl>
              </article>
            );
          })}
        </div>

        <p class="pg-veredito" data-i18n="pix.verdict">O <strong>Laya</strong>, rodando local na GPU, terminou primeiro e não custou nada, mas errou mais: 12 alarmes falsos e 1 golpe perdido. O <strong>JEV com Rust</strong> acertou as 150 mensagens com o menor uso de memória e custo de frações de centavo. O <strong>LLM generativo</strong> também acertou tudo, mas foi o mais lento e o mais caro.</p>

        <div class="pg-acoes">
          <a class="btn-outline" href="#corrida"><span data-i18n="pix.cta.race">Ver a tela da corrida</span></a>
          <a class="btn-outline" href="#comparativo"><span data-i18n="pix.cta.table">Comparativo completo</span></a>
        </div>
      </div>
    </section>

    <!-- ── 02 Comparativo ────────────────────────────────────────── -->
    <section class="section reveal-section" id="comparativo">
      <div class="container">
        <header class="section-header">
          <span class="section-index">02</span>
          <h2 data-i18n="pix.table.title">Comparativo</h2>
        </header>
        <p class="label pg-exec">
          <span data-i18n="pix.table.run">execução</span> #{execucao.id ?? 1} · <span data-i18n="pix.table.mode">modo</span> {execucao.modo ?? 'normal'} ·
          {LADOS.map((l, i) => <span>{i > 0 && ' · '}{l.nome.split(' + ')[1]}: {fins[l.id].processadas} msgs</span>)}
        </p>
        <p class="pg-placar">
          {placarOrdenado.map((l, i) => (
            <span>{i > 0 && ' · '}<b class={`pg-c-${l.id}`}>{l.nome}</b> {i === 0 && <span data-i18n="pix.table.wins">vence</span>} {placar[l.id]} {i === 0 && <span data-i18n="pix.table.rows">linhas</span>}</span>
          ))}
          <span> · {empates} <span data-i18n="pix.table.ties">empates</span></span>
        </p>
        <div class="pg-tabela-wrap">
          <table class="pg-tabela">
            <thead>
              <tr>
                <th class="label" data-i18n="pix.table.metric">Métrica</th>
                {LADOS.map(l => <th class={`label pg-c-${l.id}`}>{l.nome}</th>)}
              </tr>
            </thead>
            <tbody>
              {linhas.map(li => {
                const v = estrelas(li);
                return (
                  <tr class={li.melhor ? '' : 'pg-info'}>
                    <th class="pg-metrica" data-i18n={li.chave}>{li.rotulo}</th>
                    {LADOS.map(l => (
                      <td class={v.has(l.id) ? 'pg-melhor' : ''}>{v.has(l.id) && <span class="pg-estrela" aria-label="melhor">★</span>}{li.fmt(li.val(l.id), l.id)}</td>
                    ))}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="pg-nota" data-i18n="pix.table.note">★ = vencedor da linha entre os lados que terminaram. Tempos, custo e memória: menor é melhor. Verdadeiros positivos e saques: maior é melhor. A chegada ganha estrela mas fica fora do placar.</p>
      </div>
    </section>

    <!-- ── 03 A corrida (tela final salva) ───────────────────────── -->
    <section class="section reveal-section" id="corrida">
      <div class="container pg-container-largo">
        <header class="section-header">
          <span class="section-index">03</span>
          <h2 data-i18n="pix.race.title">A corrida</h2>
        </header>
        <p class="pg-sub pg-sub-curto" data-i18n="pix.race.sub">A tela como ficou no fim da execução, no modo normal: cada lado pega a próxima mensagem assim que termina a anterior.</p>

        <div class="pg-corrida">
          {LADOS.map(l => {
            const s = stats[l.id]; const f = s.f; const t = tela[l.id]; const g = t.ultimoGolpe;
            return (
              <article class={`pg-coluna pg-lado-${l.id}`}>
                <div class="pg-col-cab">
                  <div>
                    <h3 class="pg-card-nome">{l.nome}</h3>
                    <p class="label">{l.detalhe}</p>
                  </div>
                  <span class={`pg-selo pg-selo-${pos(l.id)}`}>{pos(l.id)}º · {fmtTotal(f.total_ms)}</span>
                </div>
                <div class="pg-chipzinhos">
                  <span class="pg-mono">{modeloTxt(l.id)}</span>
                  <span class="pg-mono">{s.memTxt}</span>
                </div>

                <div class="pg-progresso">
                  <div class="pg-progresso-num"><strong>{f.processadas}</strong> / {total}</div>
                  <div class="pg-barra"><span style="width:100%"></span></div>
                </div>

                <div class="pg-contadores">
                  <div><span class="label" data-i18n="pix.race.golpes">golpes</span><b>{t.golpesDetectados}</b></div>
                  <div><span class="label" data-i18n="pix.race.acertos">acertos</span><b>{s.acertos} <small>{pct(s.taxa)}</small></b></div>
                  <div><span class="label" data-i18n="pix.race.custo">custo</span><b>{fmtUSD(f.custo_usd)}</b></div>
                  <div><span class="label" data-i18n="pix.race.decisao">decisão p50</span><b>{fmtMs(f.p50_decisao_ms)}</b></div>
                  <div><span class="label" data-i18n="pix.race.rastreio">rastreio p50</span><b>{fmtMs(f.p50_rastreio_ms)}</b></div>
                  <div><span class="label" data-i18n="pix.race.tempo">tempo</span><b>{fmtTotal(f.total_ms)}</b></div>
                </div>

                {g && (
                  <div class="pg-msg">
                    <p class="label"><span data-i18n="pix.race.lastscam">Último golpe rastreado</span> · msg #{g.msg_id}</p>
                    <p class="pg-msg-meta pg-mono">{g.remetente} → {g.destinatario_nome}</p>
                    <blockquote>{g.texto}</blockquote>
                    <div class="pg-decisao">
                      <span class="pg-badge-golpe" data-i18n="pix.race.scam">GOLPE</span>
                      <span class="pg-mono">prob. {pct(g.prob)} · {g.tipo_golpe?.replaceAll('_', ' ')} · {fmtMs(g.t_decisao_ms)}</span>
                    </div>
                  </div>
                )}

                {g && g.rota && (
                  <div class="pg-rota">
                    <p class="label"><span data-i18n="pix.race.route">Rota do dinheiro</span> · {g.rota.saque_encontrado ? `saque em ${g.rota.hops} hops` : `${g.rota.hops} hops, sem saque`}</p>
                    <ol>
                      {g.rota.nos.map((n: any, i: number) => {
                        const a = g.rota.arestas[i];
                        const ultimo = i === g.rota.nos.length - 1;
                        const papel = i === 0 ? 'destino' : (ultimo && n.tipo === 'caixa' ? 'saque' : `hop ${i}`);
                        return (
                          <li class={`pg-no ${ultimo && n.tipo === 'caixa' ? 'pg-no-saque' : ''}`}>
                            <span class="pg-no-ponto" aria-hidden="true"></span>
                            <div class="pg-no-txt">
                              <span class="label">{papel}</span>
                              <span class="pg-no-nome">{n.nome}</span>
                              <span class="pg-no-banco">{n.banco}</span>
                            </div>
                            {a && <span class="pg-aresta pg-mono">{fmtBRL(a.valor_centavos)} · {fmtDelta(a.ts - g.ts_msg)}</span>}
                          </li>
                        );
                      })}
                    </ol>
                  </div>
                )}

                <div class="pg-log">
                  <p class="label" data-i18n="pix.race.log">Últimas mensagens</p>
                  <ul>
                    {t.log.map((e: any) => (
                      <li>
                        <details>
                          <summary>
                            <span class="pg-mono pg-log-idx">{e.idx}</span>
                            <span class={e.golpe ? 'pg-log-golpe' : 'pg-log-legit'}>{e.golpe ? 'GOLPE' : 'LEGÍTIMA'} {pct(e.prob)}</span>
                            <span class="pg-mono pg-log-ms">{fmtMs(e.t_decisao_ms)}</span>
                            <span class={e.acertou ? 'pg-ok' : 'pg-erro'}>{e.acertou ? '✓' : '✗'}</span>
                          </summary>
                          <p class="pg-log-texto">{e.texto}</p>
                        </details>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ── 04 Como funciona ──────────────────────────────────────── -->
    <section class="section reveal-section" id="como-funciona">
      <div class="container">
        <header class="section-header">
          <span class="section-index">04</span>
          <h2 data-i18n="pix.how.title">Como funciona</h2>
        </header>
        <ol class="pg-passos">
          <li><span class="stat-num">1</span><div><h3 data-i18n="pix.how.s1.t">Decisão por IA</h3><p data-i18n="pix.how.s1.d">Cada mensagem vai para a IA do lado. O JEV e o Laya respondem perguntas tipadas com probabilidade (é golpe? tem urgência? qual o tipo?). O LLM generativo responde um JSON.</p></div></li>
          <li><span class="stat-num">2</span><div><h3 data-i18n="pix.how.s2.t">Chave Pix</h3><p data-i18n="pix.how.s2.d">Em código, sem IA: a chave Pix citada no texto (CPF, CNPJ, telefone, e-mail ou aleatória) é extraída, normalizada e ligada à conta de destino.</p></div></li>
          <li><span class="stat-num">3</span><div><h3 data-i18n="pix.how.s3.t">Grafo em memória</h3><p data-i18n="pix.how.s3.d">As transações ficam num grafo CSR: cada conta é um nó e cada Pix é uma aresta com valor e instante. No Rust, vetores compactos; no Python, listas.</p></div></li>
          <li><span class="stat-num">4</span><div><h3 data-i18n="pix.how.s4.t">Rastreio até o saque</h3><p data-i18n="pix.how.s4.d">A partir da conta de destino, segue sempre o maior repasse numa janela de 72 horas, laranja a laranja, até chegar a uma conta de saque.</p></div></li>
        </ol>

        <div class="pg-ressalvas">
          <p class="label" data-i18n="pix.caveats.title">Ressalvas</p>
          <ul>
            <li data-i18n="pix.caveats.1">Dados 100% sintéticos, gerados localmente. Chaves Pix e nomes aparecem mascarados.</li>
            <li data-i18n="pix.caveats.2">O lado "DeepSeek + Python" usou o Gemini 2.5 Flash pela mesma API compatível com OpenAI, porque não havia chave do DeepSeek.</li>
            <li data-i18n="pix.caveats.3">O Laya usou uma pergunta curta. Com as perguntas longas do JEV ele marcava todas as mensagens como golpe.</li>
            <li data-i18n="pix.caveats.4">As perguntas foram ajustadas nestas mesmas mensagens, então o acerto de 100% não é uma promessa para dados novos.</li>
          </ul>
          <p class="pg-nota"><span data-i18n="pix.credits">Inspirado no vídeo do Sandeco:</span> <a class="link-item" href="https://www.youtube.com/watch?v=avQAz9norY8" target="_blank" rel="noopener">JEV+RUST: Detectando fraudes no Pix em tempo real</a></p>
        </div>
      </div>
    </section>

    <!-- ── 05 As mensagens (todas, expansíveis) ──────────────────── -->
    <section class="section reveal-section" id="mensagens">
      <div class="container">
        <header class="section-header">
          <span class="section-index">05</span>
          <h2 data-i18n="pix.msgs.title">As mensagens</h2>
        </header>
        <p class="pg-sub pg-sub-curto" data-i18n="pix.msgs.sub">Clique numa mensagem para ler o texto inteiro, ver a decisão de cada lado e a rota do dinheiro quando houve rastreio.</p>

        <div class="pg-filtros" role="group" aria-label="Filtrar mensagens">
          <button type="button" class="pg-filtro is-on" data-filtro="todas"><span data-i18n="pix.msgs.all">Todas</span> <b>{mensagens.length}</b></button>
          <button type="button" class="pg-filtro" data-filtro="golpe"><span data-i18n="pix.msgs.scams">Golpes reais</span> <b>{nGolpesMsgs}</b></button>
          <button type="button" class="pg-filtro" data-filtro="erro"><span data-i18n="pix.msgs.errors">Com erro de algum lado</span> <b>{nComErro}</b></button>
        </div>
        <p class="pg-legenda label">
          <span class="pg-c-rust">■ JEV + Rust</span> · <span class="pg-c-python">■ DeepSeek + Python</span> · <span class="pg-c-laya">■ Laya + Python</span> · ✓ <span data-i18n="pix.msgs.right">acertou</span> · ✗ <span data-i18n="pix.msgs.wrong">errou</span>
        </p>

        <ol class="pg-msgs">
          {mensagens.map(m => {
            const r = rotaDe(m);
            return (
              <li data-golpe={m.golpe ? '1' : '0'} data-erro={comErro(m) ? '1' : '0'}>
                <details>
                  <summary>
                    <span class="pg-mono pg-msgs-idx">#{m.msg_id}</span>
                    <span class={m.golpe ? 'pg-tag pg-tag-golpe' : 'pg-tag pg-tag-legit'} data-i18n={m.golpe ? 'pix.msgs.tag.scam' : 'pix.msgs.tag.legit'}>{m.golpe ? 'golpe' : 'legítima'}</span>
                    <span class="pg-msgs-previa">{m.texto}</span>
                    <span class="pg-msgs-lados">
                      {LADOS.map(l => { const e = m.lados[l.id]; return <span class={`pg-marca pg-c-${l.id}${e?.acertou ? '' : ' pg-marca-erro'}`} title={l.nome}>{e?.acertou ? '✓' : '✗'}</span>; })}
                    </span>
                  </summary>
                  <div class="pg-msgs-corpo">
                    <p class="pg-msg-meta pg-mono">{m.remetente} → {m.destinatario}</p>
                    <blockquote class={m.golpe ? '' : 'pg-bq-legit'}>{m.texto}</blockquote>
                    <div class="pg-msgs-grade">
                      {LADOS.map(l => {
                        const e = m.lados[l.id];
                        if (!e) return <div class={`pg-msgs-lado pg-lado-${l.id}`}><b>{l.nome}</b><span>—</span></div>;
                        return (
                          <div class={`pg-msgs-lado pg-lado-${l.id}`}>
                            <b class={`pg-c-${l.id}`}>{l.nome}</b>
                            <span class={e.golpe ? 'pg-log-golpe' : 'pg-log-legit'}>{e.golpe ? 'GOLPE' : 'LEGÍTIMA'} · {pct(e.prob)}</span>
                            <span class="pg-mono">{tipoTxt(e.tipo_golpe)} · {fmtMs(e.t_decisao_ms)}</span>
                            <span class={e.acertou ? 'pg-ok' : 'pg-erro'}>{e.acertou ? '✓ acertou' : '✗ errou'}</span>
                            {e.rota && <span class="pg-mono pg-msgs-rota">{e.rota.saque_encontrado ? `saque em ${e.rota.hops} hops` : `${e.rota.hops} hops, sem saque`}</span>}
                          </div>
                        );
                      })}
                    </div>
                    {r && (
                      <div class="pg-rota pg-rota-inline">
                        <p class="label"><span data-i18n="pix.race.route">Rota do dinheiro</span> · {r.rota.saque_encontrado ? `saque em ${r.rota.hops} hops` : `${r.rota.hops} hops, sem saque`}</p>
                        <ol>
                          {r.rota.nos.map((n: any, i: number) => {
                            const a = r.rota.arestas[i];
                            const ultimo = i === r.rota.nos.length - 1;
                            return (
                              <li class={`pg-no ${ultimo && n.tipo === 'caixa' ? 'pg-no-saque' : ''}`}>
                                <span class="pg-no-ponto" aria-hidden="true"></span>
                                <div class="pg-no-txt">
                                  <span class="label">{i === 0 ? 'destino' : (ultimo && n.tipo === 'caixa' ? 'saque' : `hop ${i}`)}</span>
                                  <span class="pg-no-nome">{n.nome}</span>
                                  <span class="pg-no-banco">{n.banco}</span>
                                </div>
                                {a && <span class="pg-aresta pg-mono">{fmtBRL(a.valor_centavos)} · {fmtDelta(a.ts - r.ts_msg)}</span>}
                              </li>
                            );
                          })}
                        </ol>
                      </div>
                    )}
                  </div>
                </details>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

  </main>

  <Footer />

  <script>
    import '../scripts/main.js';

    // Filtro da lista de mensagens: todas / golpes reais / com erro de algum lado
    const filtros = document.querySelectorAll<HTMLButtonElement>('.pg-filtro');
    filtros.forEach(b => b.addEventListener('click', () => {
      filtros.forEach(x => x.classList.toggle('is-on', x === b));
      const f = b.dataset.filtro;
      document.querySelectorAll<HTMLLIElement>('.pg-msgs > li').forEach(li => {
        li.hidden = f === 'golpe' ? li.dataset.golpe !== '1' : f === 'erro' ? li.dataset.erro !== '1' : false;
      });
    }));
  </script>

</body>
</html>

