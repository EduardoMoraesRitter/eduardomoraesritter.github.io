<style>
  @page { size: A4; margin: 14mm 16mm; }
  :global(body) { margin: 0; background: #fff; color: #1a1a1a; font: 10.5pt/1.45 "Segoe UI", Arial, sans-serif; }
  .eu { max-width: 180mm; margin: 0 auto; padding: 24px 0; }
  .eu-top { border-bottom: 3px solid #003399; padding-bottom: 10px; margin-bottom: 14px; }
  .eu-kicker { margin: 0; color: #003399; font-size: 9pt; letter-spacing: .08em; text-transform: uppercase; font-weight: 600; }
  h1 { margin: 4px 0 0; font-size: 22pt; color: #111; }
  .eu-block { display: grid; grid-template-columns: 52mm 1fr; column-gap: 8mm; padding: 10px 0; border-top: 1px solid #d5d9e6; }
  .eu-block > h2 { grid-column: 1; margin: 0; font-size: 10pt; color: #003399; text-transform: uppercase; letter-spacing: .05em; }
  .eu-block > :not(h2) { grid-column: 2; }
  dl { display: grid; grid-template-columns: 42mm 1fr; gap: 4px 6px; margin: 0; }
  dt { font-weight: 600; color: #333; }
  dd { margin: 0; }
  a { color: #003399; text-decoration: none; }
  .eu-item { display: grid; grid-template-columns: 30mm 1fr; column-gap: 4mm; padding: 0 0 10px; }
  .eu-item:last-child { padding-bottom: 0; }
  .eu-dates { margin: 0; color: #555; font-size: 9.5pt; font-variant-numeric: tabular-nums; }
  h3 { margin: 0; font-size: 11pt; color: #111; }
  .eu-employer { margin: 1px 0 4px; color: #003399; font-size: 9.5pt; }
  ul { margin: 0; padding-left: 16px; }
  li { margin: 0 0 2px; }
  p { margin: 0; }
  .eu-todo { background: #fff3c4; padding: 0 3px; }
  @media print { .eu { padding: 0; } a { color: inherit; } }
  @media (max-width: 640px) {
    .eu-block { grid-template-columns: 1fr; }
    .eu-block > h2, .eu-block > :not(h2) { grid-column: 1; }
    dl { grid-template-columns: 1fr; }
    .eu-item { grid-template-columns: 1fr; }
  }
</style>
