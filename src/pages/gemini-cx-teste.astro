---
const title = 'Helpdesk — teste de chamada';
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Teste de conversa por voz com o agente GECX, diretamente no navegador." />
    <title>{title}</title>
    <script is:inline defer src="https://www.gstatic.com/chat-messenger/sdk/prod/latest/chat-messenger.js"></script>
    <link rel="stylesheet" href="https://www.gstatic.com/chat-messenger/sdk/prod/latest/themes/chat-messenger-default.css" />
    <style>
      :root { color-scheme: dark; font-family: "Segoe UI", sans-serif; background: #091322; color: #edf3fc; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      main { width: min(960px, calc(100% - 32px)); margin: 0 auto; padding: 28px 0; }
      header { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 26px; }
      header a { color: #afc3db; text-decoration: none; font-size: .9rem; }
      .brand { font-size: .88rem; letter-spacing: .08em; text-transform: uppercase; color: #b5cced; }
      h1 { margin: 0 0 8px; font-size: clamp(1.8rem, 4vw, 2.6rem); letter-spacing: -.035em; }
      .intro { margin: 0 0 24px; color: #b3c4d8; line-height: 1.5; }
      .call { background: #12233a; border: 1px solid #2c425f; border-radius: 18px; overflow: hidden; }
      .controls { display: flex; align-items: center; gap: 12px; padding: 20px; flex-wrap: wrap; }
      button { min-height: 48px; padding: 12px 20px; border-radius: 10px; border: 1px solid transparent; font: inherit; font-weight: 650; cursor: pointer; }
      #start { background: #a9e8cf; color: #082f28; }
      #stop { background: #432a35; border-color: #784354; color: #ffe2e7; }
      button:disabled { opacity: .45; cursor: not-allowed; }
      button:focus-visible, a:focus-visible { outline: 3px solid #89baff; outline-offset: 4px; }
      .status { margin-left: auto; color: #c2d3e9; font-size: .92rem; }
      #timer { font-variant-numeric: tabular-nums; font-family: Consolas, monospace; margin-left: 8px; }
      .stage { background: #f8fafd; color: #23344b; min-height: 360px; }
      .empty { display: grid; place-content: center; text-align: center; min-height: 360px; padding: 28px; gap: 12px; }
      .empty svg { margin: 0 auto; color: #236652; }
      .empty h2 { font-size: 1.2rem; margin: 0; }
      .empty p { max-width: 430px; margin: 0; color: #55667c; line-height: 1.6; }
      chat-messenger { width: 100%; height: 390px; display: block; background: #f8fafd; --chat-messenger-internal-chat-border-radius: 0; --chat-messenger-color--primary: #21684f; }
      chat-messenger-container { display: block; height: 100%; }
      [hidden] { display: none !important; }
      #error { margin: 0; padding: 16px 20px; color: #ffe1e1; background: #492631; line-height: 1.5; }
      .help { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding-top: 22px; }
      .help h2 { font-size: 1rem; margin: 0 0 8px; }
      .help p { margin: 0; font-size: .93rem; line-height: 1.6; color: #b3c4d8; }
      .help a { color: #a9ceff; }
      footer { margin-top: 20px; padding-top: 15px; border-top: 1px solid #24364e; color: #99aec6; font-size: .82rem; line-height: 1.6; }
      @media(max-width:600px) { .controls { padding: 16px; } .status { width: 100%; margin: 0; } .help { grid-template-columns: 1fr; gap: 18px; } chat-messenger { height: 400px; } header { margin-bottom: 22px; } }
    </style>
  </head>
  <body>
    <main>
      <header><span class="brand">GECX / Helpdesk</span><a href="/">← Voltar ao site</a></header>
      <h1>Conversa por voz</h1>
      <p class="intro">Fala com o assistente diretamente no navegador. Não precisas de um número de telefone.</p>
      <section class="call" aria-label="Chamada com o assistente">
        <div class="controls">
          <button id="start" type="button" disabled>Iniciar chamada</button>
          <button id="stop" type="button" disabled>Terminar chamada</button>
          <span class="status" role="status" aria-live="polite"><span id="status">A preparar o assistente…</span><span id="timer"></span></span>
        </div>
        <p id="error" role="alert" hidden></p>
        <div class="stage">
          <div id="empty" class="empty">
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8"/></svg>
            <h2>O microfone só abre quando iniciares</h2>
            <p>Autoriza o microfone quando o navegador pedir. Usa auscultadores para evitar eco.</p>
          </div>
          <chat-messenger id="voice" language-code="pt" url-allowlist="*" hidden>
            <chat-messenger-container chat-title="Assistente Helpdesk" enable-audio-input-only></chat-messenger-container>
          </chat-messenger>
        </div>
      </section>
      <section class="help" aria-label="Sugestões para o teste">
        <div><h2>Experimenta dizer</h2><p>“Olá, sou o Eduardo. Preciso de ajuda com o acesso à VPN.” Depois podes pedir para consultar um ticket.</p></div>
        <div><h2>Precisas de escrever?</h2><p><a href="/gecx-poc/">Abrir a versão de chat</a>. A passagem para um operador humano nesta demonstração é simulada.</p></div>
      </section>
      <footer>Usa apenas dados fictícios. O áudio é enviado ao Google para processamento e a conversa pode ser registada no projeto. O consumo de GECX pode gerar custos. Cada teste termina automaticamente aos 4 minutos.</footer>
    </main>
    <script is:inline>
      const start = document.getElementById('start');
      const stop = document.getElementById('stop');
      const messenger = document.getElementById('voice');
      const empty = document.getElementById('empty');
      const status = document.getElementById('status');
      const timer = document.getElementById('timer');
      const error = document.getElementById('error');
      let active = false, tick, limit, startedAt = 0, mediaStream, generation = 0;
      function finish(message = 'Chamada terminada') {
        if (!active) return;
        active = false;
        generation += 1;
        clearInterval(tick); clearTimeout(limit); tick = undefined;
        messenger.presenter?.terminateBidiClient?.();
        mediaStream?.getTracks().forEach(track => track.stop()); mediaStream = undefined;
        messenger.hidden = true; empty.hidden = false;
        start.disabled = false; stop.disabled = true;
        status.textContent = message;
      }
      function showError(detail = {}) {
        if (!active) return;
        finish('Não foi possível continuar a chamada');
        const code = String(detail.status === 429 ? 429 : detail.code || detail.status || detail.errorCode || '');
        error.textContent = code === '429'
          ? 'O Google recusou o pedido por falta de quota ou capacidade (429). A chamada foi terminada para evitar novas tentativas automáticas.'
          : ['NotAllowedError', 'NotFoundError', 'NotReadableError'].includes(detail.name)
            ? 'O microfone não está disponível. Permite o acesso nas definições deste site e volta a tentar.'
            : 'A conversa com o Google foi interrompida. Verifica a ligação e volta a tentar. ' + (code ? '(Código ' + code + ')' : '');
        error.hidden = false;
      }
      window.addEventListener('chat-messenger-loaded', () => {
        chatSdk.registerContext(chatSdk.prebuilts.ces.createContext({
          deploymentName: 'projects/501912525936/locations/us/apps/ed178bc4-49d8-4b9c-8422-dd76d3e1a445/deployments/36b553cc-337a-41ff-b788-f22789f63d08',
          tokenBroker: { enableTokenBroker: true, enableRecaptcha: true },
          enableWelcomeEvent: false,
        }));
        start.disabled = false; status.textContent = 'Pronto para começar';
      }, { once: true });
      start.addEventListener('click', async () => {
        if (active) return;
        error.hidden = true;
        if (!window.isSecureContext || !navigator.mediaDevices?.getUserMedia) {
          error.textContent = 'Abre esta página em HTTPS num navegador com suporte de microfone.';
          error.hidden = false; return;
        }
        active = true; start.disabled = true; stop.disabled = false;
        const attempt = ++generation;
        empty.hidden = true; messenger.hidden = false;
        status.textContent = 'A ligar — autoriza o microfone';
        timer.textContent = '';
        limit = setTimeout(() => finish('Limite de teste atingido (4 min)'), 240000);
        try {
          // The SDK's voice control uses this same streaming-session method.
          if (typeof messenger.presenter?.toggleBidiSession !== 'function') throw new Error('Voice SDK unavailable');
          const stream = await messenger.presenter.toggleBidiSession(true);
          if (attempt !== generation || !active) {
            stream?.getTracks().forEach(track => track.stop());
            if (!active) messenger.presenter?.terminateBidiClient?.();
            return;
          }
          mediaStream = stream;
        } catch (failure) { if (attempt === generation) showError(failure); }
      });
      stop.addEventListener('click', () => finish());
      messenger.addEventListener('chat-messenger-connect-bidi', () => {
        if (!active) return;
          status.textContent = 'Chamada em curso';
          if (!tick) {
            startedAt = Date.now();
            tick = setInterval(() => { const seconds = Math.floor((Date.now() - startedAt) / 1000); timer.textContent = Math.floor(seconds / 60) + ':' + String(seconds % 60).padStart(2, '0'); }, 1000);
          }
      });
      messenger.addEventListener('chat-messenger-disconnect-bidi', () => {
        if (!active) return;
          clearInterval(tick); tick = undefined;
          status.textContent = 'Microfone desligado';
      });
      messenger.addEventListener('chat-messenger-error', event => showError(event.detail || {}));
      messenger.addEventListener('chat-messenger-error-v2', event => showError(event.detail || {}));
      window.addEventListener('pagehide', () => finish());
    </script>
  </body>
</html>
