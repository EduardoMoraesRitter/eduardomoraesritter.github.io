---
const title = 'Helpdesk — conversa com o assistente';
---

<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content="Conversa por voz ou chat com o assistente Helpdesk, diretamente no navegador." />
  <title>{title}</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23509a99'/%3E%3C/svg%3E" />
  <script is:inline defer src="/gemini-cx-demo/diagnostics.js"></script>
  <script is:inline defer src="/gemini-cx-demo/session-auth.js"></script>
  <script is:inline defer src="https://www.gstatic.com/chat-messenger/sdk/prod/latest/chat-messenger.js"></script>
  <link rel="stylesheet" href="https://www.gstatic.com/chat-messenger/sdk/prod/latest/themes/chat-messenger-default.css" />
  <style>
    :root { color-scheme:light; font-family:"Segoe UI",sans-serif; color:#171918; background:#fff; --surface:#f5f4f2; --line:#e5e3df; --muted:#646662; --ink:#171918; }
    * { box-sizing:border-box; }
    body { margin:0; padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); }
    button,a { -webkit-tap-highlight-color:transparent; }
    button,select,textarea { font:inherit; }
    button { cursor:pointer; }
    button:disabled { cursor:wait; opacity:.45; }
    button:focus-visible,a:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible { outline:3px solid #236d79; outline-offset:5px; }
    a { color:inherit; text-underline-offset:4px; }
    [hidden] { display:none !important; }
    ::selection { background:#cceade; color:#17392d; }
    main { width:min(1120px,calc(100% - 32px)); margin:0 auto; padding:16px 0 24px; }
    .page-header { min-height:60px; display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:12px; }
    h1 { margin:0; font-size:clamp(1.125rem,2.2vw,1.5rem); font-weight:550; letter-spacing:-.025em; }
    .back { min-height:44px; display:inline-flex; align-items:center; gap:8px; color:var(--muted); text-decoration:none; font-size:.875rem; flex:none; }
    .back svg { width:16px; height:16px; }
    .demo { position:relative; background:var(--surface); border:1px solid var(--line); border-radius:28px; }
    .settings-row { display:flex; align-items:center; flex-wrap:wrap; gap:8px 16px; padding:16px 24px 0; font-size:.875rem; color:var(--muted); }
    .settings-row label { color:var(--ink); }
    #language { min-height:44px; max-width:100%; padding:8px 32px 8px 12px; border:1px solid #d6d9d2; border-radius:12px; color:var(--ink); background:#fff; font-size:1rem; }
    #language:disabled { opacity:.65; }
    #language-hint { margin:0; }
    .workspace { position:relative; min-width:0; height:clamp(480px,65svh,610px); }
    .voice-view { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:30px; padding:36px 24px 12px; }
    .orb-wrap { --voice-level:0; --signal-level:0; position:relative; isolation:isolate; flex:none; width:clamp(210px,35vw,310px); aspect-ratio:1; margin-bottom:20px; }
    .orb-wrap::before,.orb-wrap::after { content:""; position:absolute; inset:0; border:1.5px solid #509a99; border-radius:50%; pointer-events:none; opacity:calc(var(--signal-level)*.5); transform:scale(calc(1 + var(--voice-level)*.2)); }
    .orb-wrap::after { opacity:calc(var(--signal-level)*.25); transform:scale(calc(1 + var(--voice-level)*.34)); }
    .orb-wrap[data-activity="speaking"]::before,.orb-wrap[data-activity="speaking"]::after { border-color:#4b9dcc; }
    .orb { position:relative; width:100%; height:100%; border-radius:50%; overflow:hidden; transform:scale(calc(1 + var(--voice-level)*.105)); transition:opacity 200ms; background:radial-gradient(ellipse at 70% 27%,#d9ffd9,transparent 46%),radial-gradient(ellipse at 17% 23%,#438b56,transparent 60%),#6dc8e7; }
    .orb canvas { display:block; width:100%; height:100%; border-radius:inherit; }
    .orb[data-active="true"] canvas { animation:orbit 12s ease-in-out infinite alternate; }
    .orb[data-muted="true"] { opacity:.6; }
    @keyframes orbit { from { transform:rotate(-7deg) scale(1.07); } to { transform:rotate(9deg) scale(1.14); } }
    .call-switch { position:absolute; z-index:1; bottom:-26px; left:50%; transform:translateX(-50%); padding:8px; border-radius:50%; background:var(--surface); }
    .call-button { width:58px; height:58px; display:grid; place-items:center; padding:0; border:0; border-radius:50%; color:#fff; background:#111312; box-shadow:0 2px 4px #0002; transition:background-color 150ms ease; }
    .call-button svg { width:23px; height:23px; }
    #stop { background:#a82d32; }
    .conversation { width:min(100%,580px); min-height:88px; text-align:center; }
    .status-line { display:flex; align-items:center; justify-content:center; gap:10px; min-height:24px; margin-bottom:8px; }
    #status { font-size:.9375rem; font-weight:500; line-height:1.5; }
    #timer { font-size:.875rem; font-variant-numeric:tabular-nums; color:var(--muted); }
    #timer:not(:empty)::before { content:"·"; margin-right:10px; }
    .transcript { max-height:108px; overflow-y:auto; scrollbar-width:thin; scrollbar-color:#b8c0bb transparent; margin:0; padding-inline:4px; font-size:.9375rem; color:var(--muted); line-height:1.6; overflow-wrap:anywhere; }
    .toolbar { display:grid; grid-template-columns:1fr auto; align-items:center; gap:20px 12px; padding:20px; }
    .agent { display:flex; align-items:center; gap:10px; min-width:0; }
    .avatar { width:42px; height:42px; flex:none; padding:5px; background:#fff; border:1px solid #dcded9; border-radius:50%; }
    .avatar span { display:block; height:100%; border-radius:50%; background:radial-gradient(ellipse at 75% 15%,#e0fedf,transparent 48%),radial-gradient(ellipse at 10% 10%,#528b42,transparent 65%),#75cbe7; }
    .agent-name { font-size:.9375rem; font-weight:500; line-height:1.4; }
    .agent-provider { display:block; margin-top:2px; font-size:.75rem; color:var(--muted); }
    .modes { display:flex; gap:4px; padding:4px; background:#eeedea; border-radius:999px; }
    .modes button { min-width:62px; min-height:44px; padding:8px 16px; border:1px solid transparent; border-radius:999px; background:transparent; color:#5d605a; font-size:.9375rem; }
    .modes button[aria-selected="true"] { background:#fff; border-color:#deded9; color:var(--ink); box-shadow:0 1px 3px #0000000a; }
    .toolbar-actions { grid-column:1/-1; display:flex; justify-content:center; align-items:center; gap:10px; }
    .help-button,.mute-button { display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:44px; padding:10px 18px; border-radius:999px; font-size:.875rem; white-space:nowrap; }
    .help-button { color:#fff; background:#111312; border:1px solid #111312; }
    .mute-button { color:var(--ink); border:1px solid #d6d9d2; background:transparent; }
    .mute-button svg { width:18px; height:18px; }
    .mute-button[aria-pressed="true"] { background:#e3e7e0; }
    #error { margin:0 20px 16px; padding:16px; background:#f9e6e5; color:#853136; border-radius:12px; line-height:1.5; font-size:.9375rem; overflow-wrap:anywhere; }
    #error[data-kind="response-timeout"] { background:#f4ead1; color:#705114; }
    #error p { margin:4px 0 12px; }
    .recovery-actions { display:flex; flex-wrap:wrap; gap:8px; }
    .recovery-actions button,.chat-form button,.diagnostics button { min-height:44px; border:1px solid #c7cdc5; border-radius:12px; padding:8px 16px; color:var(--ink); background:#fff; }
    .chat-view { display:flex; flex-direction:column; height:100%; padding:24px 24px 0; gap:12px; }
    .chat-log { flex:1; min-height:0; overflow-y:auto; padding:8px; display:flex; flex-direction:column; gap:14px; scrollbar-width:thin; }
    .chat-message { max-width:min(85%,620px); padding:12px 16px; border-radius:16px; background:#fff; line-height:1.6; overflow-wrap:anywhere; white-space:pre-wrap; }
    .chat-message[data-role="user"] { align-self:flex-end; background:#e0ebe4; }
    .chat-message strong { display:block; font-size:.75rem; margin-bottom:3px; color:#535d55; }
    .chat-empty { margin:auto; color:var(--muted); text-align:center; line-height:1.7; }
    .chat-form { display:flex; gap:8px; align-items:flex-end; }
    .chat-form textarea { flex:1; min-width:0; min-height:54px; max-height:120px; resize:vertical; padding:12px; border:1px solid #c7cdc5; border-radius:12px; background:#fff; font-size:1rem; }
    #chat-status { min-height:22px; margin:0; color:var(--muted); font-size:.875rem; }
    .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
    /* Keep one SDK view mounted: mode changes never rebuild its internal message list. */
    .sdk-host { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); opacity:0; pointer-events:none; contain:layout paint; }
    chat-messenger { display:block; width:100%; height:100%; --chat-messenger-font-family:"Segoe UI",sans-serif; --chat-messenger-color--primary:#246b57; --chat-messenger-color--surface:#f5f4f2; --chat-messenger-color--surface-container:#f5f4f2; --chat-messenger-internal-chat-border-radius:0; --chat-messenger-internal-message-list-max-width:760px; }
    chat-messenger-container { display:block; width:100%; height:100%; --chat-messenger-internal-visual-viewport-height:100%; }
    .help-panel { display:grid; gap:24px; padding:28px 8px 12px; }
    .help-panel h2 { margin:0 0 8px; font-size:1rem; font-weight:600; }
    .help-panel p { margin:0; line-height:1.65; color:#555a54; }
    .help-panel details { border-top:1px solid var(--line); padding-top:16px; }
    .help-panel summary,.diagnostics summary { cursor:pointer; min-height:44px; font-weight:600; line-height:1.6; }
    .help-panel ul { padding-left:20px; line-height:1.7; color:#555a54; }
    .help-panel .wide { grid-column:1/-1; }
    .diagnostics { margin-top:20px; padding:16px; border:1px solid var(--line); border-radius:16px; }
    .diagnostics p { color:var(--muted); line-height:1.6; font-size:.875rem; }
    .diagnostics pre { max-height:250px; overflow:auto; white-space:pre-wrap; overflow-wrap:anywhere; background:#f5f4f2; padding:12px; border-radius:10px; font-size:.75rem; }
    footer { display:flex; flex-wrap:wrap; justify-content:space-between; gap:8px 24px; padding:16px 4px 0; font-size:.75rem; color:#6b6f67; line-height:1.7; }
    footer p { margin:0; max-width:86ch; }
    footer .limit { white-space:nowrap; }
    @media(min-width:720px) {
      main { width:min(1120px,calc(100% - 64px)); padding-top:24px; }
      .toolbar { grid-template-columns:minmax(0,1fr) auto minmax(0,1fr); padding:24px 32px; gap:20px; }
      .toolbar-actions { grid-column:auto; justify-content:flex-end; }
      .agent-name { font-size:1rem; }
      .avatar { width:48px; height:48px; }
      .voice-view { gap:40px; padding-top:42px; }
      .help-panel { grid-template-columns:repeat(2,minmax(0,1fr)); gap:40px; padding:28px 12px 12px; }
    }
    @media(max-width:359px) {
      main { width:calc(100% - 24px); }
      .toolbar { grid-template-columns:1fr; justify-items:center; }
      .toolbar-actions { grid-column:auto; }
      .page-header { gap:8px; }
      .back span { display:none; }
      .back { min-width:44px; justify-content:center; }
    }
    @media(hover:hover) { .call-button:hover:not(:disabled),.help-button:hover { background:#353b36; } #stop:hover { background:#8c2328; } .modes button:hover:not([aria-selected="true"]) { color:#111; background:#e6e6e0; } .back:hover { color:#111; } }
    @media(prefers-reduced-motion:reduce) { .orb,.call-button { transition:none; } .orb { transform:none; } .orb-wrap::before,.orb-wrap::after { display:none; } .orb[data-active="true"] canvas { animation:none; } }
  </style>
</head>
<body>
  <main>
    <header class="page-header">
      <h1>Conversa com o Helpdesk</h1>
      <a class="back" href="/" aria-label="Voltar ao site"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h13"/></svg><span>Voltar ao site</span></a>
    </header>
    <section id="demo" class="demo" data-mode="voice" aria-label="Assistente Helpdesk">
      <div class="settings-row"><label for="language">Idioma da conversa</label><select id="language" aria-describedby="language-hint"><option value="auto">Automático</option><option value="pt-BR">Português (Brasil)</option><option value="en-US">English (US)</option><option value="es-ES">Español (España)</option></select><p id="language-hint">Preferência enviada ao assistente no início.</p></div>
      <div class="workspace">
        <div id="voice-view" class="voice-view" role="tabpanel" aria-labelledby="voice-tab">
          <div class="orb-wrap">
            <div id="orb" class="orb" aria-hidden="true"><canvas id="orb-canvas" width="480" height="480"></canvas></div>
            <div class="call-switch">
              <button id="start" class="call-button" type="button" aria-label="Iniciar chamada" title="Iniciar chamada" disabled><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-2.6a1 1 0 0 0-.8-1l-3.3-.7a1 1 0 0 0-1 .3l-1.8 1.8a14.7 14.7 0 0 1-7.9-7.9L8 8.1a1 1 0 0 0 .3-1l-.7-3.3a1 1 0 0 0-1-.8Z"/></svg></button>
              <button id="stop" class="call-button" type="button" aria-label="Terminar chamada" title="Terminar chamada" hidden><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2.2 10.5a17 17 0 0 1 19.6 0c.8.6 1.1 1.6.7 2.5l-1 2.1c-.2.5-.8.8-1.3.6l-3.8-1.1c-.5-.1-.8-.6-.8-1.1v-2.1a14 14 0 0 0-7.2 0v2.1c0 .5-.3 1-.8 1.1l-3.8 1.1c-.5.2-1.1-.1-1.3-.6l-1-2.1c-.4-.9-.1-1.9.7-2.5Z"/></svg></button>
            </div>
          </div>
          <div class="conversation">
            <div class="status-line"><span id="status" role="status">A preparar o assistente…</span><span id="timer" aria-label="Duração da chamada"></span></div>
            <p id="transcript" class="transcript" aria-live="polite" aria-atomic="true">Autoriza o microfone e fala naturalmente.</p>
          </div>
        </div>
        <div id="chat-view" class="chat-view" role="tabpanel" aria-labelledby="chat-tab" hidden>
          <div id="chat-log" class="chat-log" role="log" aria-label="Mensagens da conversa" aria-live="polite"><p id="chat-empty" class="chat-empty">Escreve para o mesmo assistente.<br />Usa apenas dados fictícios neste teste.</p></div>
          <p id="chat-status" role="status"></p>
          <form id="chat-form" class="chat-form"><label class="sr-only" for="chat-input">A tua mensagem</label><textarea id="chat-input" rows="2" maxlength="4000" placeholder="Escreve a tua mensagem…" required></textarea><button id="chat-send" type="submit" disabled>Enviar</button></form>
        </div>
        <div id="sdk-host" class="sdk-host" aria-hidden="true" inert>
          <chat-messenger id="voice" language-code="pt" disable-viewport-management url-allowlist="*"><chat-messenger-container chat-title="Assistente Helpdesk" no-titlebar enable-audio-input-only></chat-messenger-container></chat-messenger>
        </div>
      </div>
      <section id="error" aria-label="Estado da ligação" hidden><div role="alert"><strong id="error-title"></strong><p id="error-message"></p></div><div class="recovery-actions"><button id="retry" type="button">Voltar a ligar</button><button id="reload" type="button">Atualizar página</button></div></section>
      <div class="toolbar">
        <div class="agent"><div class="avatar" aria-hidden="true"><span></span></div><div class="agent-name">Assistente Helpdesk<span class="agent-provider">Google · GECX</span></div></div>
        <div class="modes" role="tablist" aria-label="Modo de conversa">
          <button id="voice-tab" type="button" role="tab" aria-selected="true" aria-controls="voice-view">Voz</button>
          <button id="chat-tab" type="button" role="tab" aria-selected="false" aria-controls="chat-view" tabindex="-1">Chat</button>
        </div>
        <div class="toolbar-actions">
          <button id="mute" class="mute-button" type="button" aria-label="Silenciar microfone" aria-pressed="false" title="Silenciar microfone" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8"/><path id="mute-slash" d="m3 3 18 18" hidden/></svg></button>
          <button id="help-toggle" class="help-button" type="button" aria-expanded="false" aria-controls="help-panel">Ajuda e idiomas</button>
        </div>
      </div>
    </section>
    <section id="help-panel" class="help-panel" aria-label="Sugestões para o teste" hidden>
      <div><h2>Começa uma conversa</h2><p>Carrega no telefone e permite o acesso ao microfone. Experimenta: “Olá, sou o Eduardo. Preciso de ajuda com o acesso à VPN.” Usa auscultadores para evitar eco.</p></div>
      <div><h2>Explora o assistente</h2><p>Podes pedir ajuda, consultar um ticket ou mudar para Chat para escrever. A passagem para um operador humano nesta demonstração é simulada.</p></div>
      <div><h2>Microfone e ligação são diferentes</h2><p>A esfera reage à captação local e ao áudio do assistente. Movimento não garante uma resposta do Google. O estado indica quando estamos a aguardar. O mudo permite continuar a ouvir, sem enviar a tua voz; não suspende o tempo da chamada.</p></div>
      <div><h2>Se a conversa parar</h2><p>Cada chamada tem um limite de quatro minutos, contado a partir da ligação. Uma falha anterior pode ter outra origem. A mensagem distingue inatividade, microfone, acesso e limites quando o Google fornece essa informação. “Voltar a ligar” começa uma nova conversa, sem repetir automaticamente pedidos nem abrir o microfone sem o teu clique.</p></div>
      <details class="wide"><summary>Idiomas, vozes e português de Portugal</summary><p>O seletor envia uma preferência de idioma como instrução da conversa; não troca o modelo de voz nem funciona como um tradutor separado. Em Automático, fala na língua pretendida. O comportamento depende das instruções e idiomas suportados pelo agente.</p><p>Português de Portugal (pt-PT) não consta da lista oficial de voz do CX Agent Studio. Está listado português do Brasil (pt-BR). Preferir palavras como “telemóvel” ou “palavra-passe” não garante um sotaque português. Para chat escrito, os modelos Gemini suportam mais idiomas.</p><ul><li><strong>Disponibilidade geral (GA):</strong> português do Brasil; inglês dos EUA; francês de França e do Canadá; alemão da Alemanha; espanhol de Espanha e dos EUA.</li><li><strong>Preview:</strong> inglês do Reino Unido, Austrália, Canadá e Índia; espanhol do México; neerlandês dos Países Baixos e Bélgica; mandarim, dinamarquês, finlandês, hindi, hinglish, indonésio, italiano, japonês, coreano, marata, polaco, romeno, spanglish, sueco, tâmil, telugo, turco e vietnamita.</li></ul><p>Lista consultada em 11/09/2026. <a href="https://docs.cloud.google.com/gemini-enterprise-cx/cx-agent-studio/reference/language" target="_blank" rel="noopener noreferrer">Idiomas oficiais</a> · <a href="https://docs.cloud.google.com/gemini-enterprise-cx/cx-agent-studio/settings" target="_blank" rel="noopener noreferrer">Definições de idioma e voz no Google</a></p></details>
      <details class="wide"><summary>O que sabemos sobre as interrupções</summary><p>Foi observado o erro genérico de áudio 15/6. Ele não comprova falta de quota nem uma falha na tua rede. O detalhe 15/3 identifica inatividade; um limite explícito pode surgir como HTTP 429. Também observámos uma exceção de interface no componente do Google, sem prova de que tenha terminado o áudio.</p><p>Esta versão mantém a vista interna do componente estável, regista os códigos recebidos e permite uma nova sessão. As falhas do serviço ou de ferramentas externas continuam a exigir diagnóstico no projeto Google. O registo abaixo é apenas do navegador e não substitui os registos do serviço.</p></details>
    </section>
    <details class="diagnostics"><summary>Diagnóstico deste teste</summary><p>Eventos desta página, mantidos apenas em memória. Não inclui áudio, mensagens, nomes, credenciais nem tokens. Copia este registo se precisares de reportar um erro.</p><button id="copy-diagnostics" type="button">Copiar diagnóstico</button><span id="copy-status" role="status"></span><pre id="diagnostic-output">Ainda sem eventos.</pre></details>
    <footer><p>Usa dados fictícios. O áudio é processado pelo Google e a conversa pode ser registada. O consumo de GECX pode gerar custos.</p><p class="limit">Limite por chamada: 4 minutos</p></footer>
  </main>
  <script is:inline>
    const demo=document.getElementById('demo'), start=document.getElementById('start'), stop=document.getElementById('stop');
    const messenger=document.getElementById('voice'), container=messenger.querySelector('chat-messenger-container');
    const voiceView=document.getElementById('voice-view'), chatView=document.getElementById('chat-view');
    const voiceTab=document.getElementById('voice-tab'), chatTab=document.getElementById('chat-tab');
    const status=document.getElementById('status'), timer=document.getElementById('timer'), transcript=document.getElementById('transcript');
    const error=document.getElementById('error'), mute=document.getElementById('mute'), orb=document.getElementById('orb'), orbWrap=orb.parentElement;
    const language=document.getElementById('language'), retry=document.getElementById('retry'), reload=document.getElementById('reload');
    const chatInput=document.getElementById('chat-input'), chatSend=document.getElementById('chat-send'), chatStatus=document.getElementById('chat-status'), chatLog=document.getElementById('chat-log');
    let active=false, ready=false, muted=false, tick, limit, startedAt=0, mediaStream, generation=0;
    let meterContext, meterSource, meterAnalyser, meterSamples, meterFrame, connected=false;
    let outputLevel=0, outputAt=0, userAt=0, smoothLevel=0, lastMeterPaint=0;
    let journal, pendingStart=false, phase='idle', connectTimer, hasSession=false, preferenceSent=false;
    let lastEnd={kind:'none',at:0}, pendingResponseAt=0, chatBusy=false, chatGeneration=0, chatResponseCount=0, chatTimer;
    const preferences={
      'pt-BR':'Please conduct this conversation in Portuguese (Brazil).',
      'en-US':'Please conduct this conversation in English (United States).',
      'es-ES':'Please conduct this conversation in Spanish (Spain).',
    };
    function record(event,detail={}){
      if(!window.GecxDiagnostics)return;
      journal??=GecxDiagnostics.createJournal(40);
      journal.add(event,{attempt:generation,mode:demo.dataset.mode,language:language.value,...detail});
      document.getElementById('diagnostic-output').textContent=JSON.stringify({app:'gecx-browser-demo',sdk:'prod/latest',events:journal.entries()},null,2);
    }
    function controls(){
      start.disabled=!ready||pendingStart||chatBusy||!navigator.onLine;
      retry.disabled=!ready||pendingStart||chatBusy||!navigator.onLine;
      retry.hidden=error.dataset.action==='reload'||(pendingStart&&!active);
      chatSend.disabled=!ready||pendingStart||chatBusy||active||!navigator.onLine;
      language.disabled=active||pendingStart||chatBusy;
    }
    function clearError(){error.hidden=true;error.dataset.kind='';}
    function presentError(detail){
      const info=GecxDiagnostics.describe({...detail,mode:demo.dataset.mode});
      // The SDK can emit a generic follow-up after the detailed service error.
      if(!error.hidden&&['capacity','access'].includes(error.dataset.kind)&&['stream','chat-request'].includes(info.kind))return;
      error.dataset.kind=info.kind;error.dataset.action=info.action;document.getElementById('error-title').textContent=info.title;
      document.getElementById('error-message').textContent=info.message;
      retry.hidden=info.action==='reload';retry.textContent=demo.dataset.mode==='chat'?'Nova conversa':'Voltar a ligar';
      error.hidden=false;controls();
    }

    // Original procedural texture, drawn once. Audio animates the containing orb.
    function drawOrb() {
      const canvas=document.getElementById('orb-canvas'), ctx=canvas.getContext('2d');
      if (!ctx) return;
      const n=canvas.width, picture=ctx.createImageData(n,n), data=picture.data;
      const mix=(a,b,f)=>a.map((v,i)=>v*(1-f)+b[i]*f);
      for(let y=0;y<n;y++) for(let x=0;x<n;x++) {
        const u=(x+.5)/n*2-1,v=(y+.5)/n*2-1,r=u*u+v*v;
        if(r>1) continue;
        const z=Math.sqrt(1-r),i=(y*n+x)*4;
        const green=Math.exp(-((u+.37)**2/.65+(v+.57)**2/.7));
        const lime=Math.exp(-((u-.26)**2/.3+(v+.56)**2/.27));
        const light=Math.exp(-((u-.57)**2/.36+(v+.12)**2/.22));
        let c=mix([64,163,224],[57,116,68],green*.96);
        c=mix(c,[169,218,143],lime*.9); c=mix(c,[222,255,251],light*.94);
        const rim=Math.pow(1-z,3)*22,grain=(Math.sin(x*127.1+y*311.7)*43758.5453%1)*14,shade=.94+z*.09+u*.035;
        for(let k=0;k<3;k++) data[i+k]=Math.max(0,Math.min(255,c[k]*shade+rim+grain));
        data[i+3]=Math.min(255,(1-r)*n*128);
      }
      ctx.putImageData(picture,0,0);
    }
    drawOrb();
    function resetOrb(){
      orb.dataset.active='false';orb.dataset.muted='false';orbWrap.dataset.activity='idle';
      orbWrap.style.setProperty('--voice-level','0');orbWrap.style.setProperty('--signal-level','0');
    }
    function stopMeter(){
      cancelAnimationFrame(meterFrame);meterFrame=undefined;
      meterSource?.disconnect();meterSource=undefined;meterAnalyser=undefined;meterSamples=undefined;
      if(meterContext&&meterContext.state!=='closed')meterContext.close().catch(()=>{});
      meterContext=undefined;outputLevel=0;outputAt=0;userAt=0;smoothLevel=0;lastMeterPaint=0;
    }
    function startMeter(stream){
      stopMeter();
      try{
        // Analysis only: never connect this microphone source to the speakers.
        meterContext=new (window.AudioContext||window.webkitAudioContext)();
        meterContext.resume().catch(()=>{});
        meterSource=meterContext.createMediaStreamSource(stream);
        meterAnalyser=meterContext.createAnalyser();meterAnalyser.fftSize=512;
        meterSamples=new Float32Array(meterAnalyser.fftSize);meterSource.connect(meterAnalyser);
      }catch{/* The call and output feedback can continue without local metering. */}
      function paint(now){
        if(!active)return;
        meterFrame=requestAnimationFrame(paint);
        if(now-lastMeterPaint<32)return;lastMeterPaint=now;
        let rms=0;
        if(meterAnalyser&&!muted){meterAnalyser.getFloatTimeDomainData(meterSamples);for(const n of meterSamples)rms+=n*n;rms=Math.sqrt(rms/meterSamples.length);}
        if(rms>.007)userAt=now;
        const userSpeaking=!muted&&userAt>0&&now-userAt<350;
        const assistantSpeaking=outputAt>0&&now-outputAt<250;
        const voiceEnergy=Math.min(1,Math.sqrt(rms)*3.3);
        const incoming=assistantSpeaking?outputLevel:0;
        const breath=connected&&!muted ? .055+Math.sin(now/600)*.025 : 0;
        const target=Math.max(voiceEnergy,incoming,breath);
        smoothLevel+=(target-smoothLevel)*(target>smoothLevel ? .4 : .15);
        orbWrap.style.setProperty('--voice-level',smoothLevel.toFixed(3));
        orbWrap.style.setProperty('--signal-level',Math.min(1,smoothLevel*1.6).toFixed(3));
        const waiting=pendingResponseAt>0&&Date.now()-pendingResponseAt>2500;
        const activity=assistantSpeaking?'speaking':muted?'muted':userSpeaking?'hearing':waiting?'waiting':'listening';
        if(orbWrap.dataset.activity!==activity){
          orbWrap.dataset.activity=activity;
          if(connected)status.textContent=assistantSpeaking?(muted?'Assistente a falar · microfone silenciado':'Assistente a falar'):muted?'Microfone silenciado':userSpeaking?'A captar a tua voz':waiting?'A aguardar resposta do Google':'A ouvir';
        }
      }
      meterFrame=requestAnimationFrame(paint);
    }
    function finish(message='Chamada terminada',kind='user') {
      if(!active)return;
      lastEnd={kind,at:Date.now()};active=false;connected=false;phase='idle';generation+=1;
      clearInterval(tick);clearTimeout(limit);clearTimeout(connectTimer);tick=undefined;pendingResponseAt=0;stopMeter();
      record('call-ended',{kind});
      try{messenger.presenter?.terminateBidiClient?.();}catch{/* Always release our microphone tracks. */}
      mediaStream?.getTracks().forEach(track=>track.stop());mediaStream=undefined;
      const returnFocus=document.activeElement===stop||document.activeElement===mute;
      start.hidden=false;stop.hidden=true;mute.hidden=true;status.textContent=message;resetOrb();controls();
      if(returnFocus)start.focus({preventScroll:true});
    }
    function showError(detail={},force=false) {
      record('error',detail);
      const lateError=['disconnect','error'].includes(lastEnd.kind)&&Date.now()-lastEnd.at<5000;
      if(!force&&!active&&!chatBusy&&!lateError)return;
      finish('Não foi possível continuar a chamada','error');
      if(chatBusy){chatStatus.textContent='A mensagem não foi concluída. Não será reenviada automaticamente.';}
      presentError(detail);
    }
    function waitForToken(reset=false){
      return GecxSessionAuth.waitForAuthorization({
        readState:()=>chatSdk.getContext()?.state,
        eventTarget:window,
        ...(reset?{reset:()=>messenger.startNewSession()}:{}),
      });
    }
    async function prepareSession(){
      await waitForToken(hasSession);hasSession=true;preferenceSent=false;record('session-ready');
    }
    async function applyVoicePreference(){
      if(!active||!connected||!mediaStream||preferenceSent)return;
      preferenceSent=true;
      if(!preferences[language.value])return;
      record('language-preference');pendingResponseAt=Date.now();
      try{await messenger.sendQuery(preferences[language.value]);}catch(failure){showError(failure);}
    }
    function initialize(){
      if(ready)return;
      if(!window.GecxDiagnostics||!window.GecxSessionAuth)return;
      chatSdk.registerContext(chatSdk.prebuilts.ces.createContext({
        deploymentName:'projects/501912525936/locations/us/apps/ed178bc4-49d8-4b9c-8422-dd76d3e1a445/deployments/36b553cc-337a-41ff-b788-f22789f63d08',
        tokenBroker:{enableTokenBroker:true,enableRecaptcha:true},enableWelcomeEvent:false,
      }));
      ready=true;controls();status.textContent='Iniciar uma conversa';record('sdk-ready');
    }
    window.addEventListener('chat-messenger-access-token-resolved',()=>record('authorization-ready'));
    window.addEventListener('chat-messenger-loaded',initialize,{once:true});
    setTimeout(()=>{if(!ready){status.textContent='O assistente não carregou';transcript.textContent='Atualiza a página para voltar a tentar.';if(window.GecxDiagnostics)presentError({kind:'sdk-load'});}},20000);
    async function startCall(){
      if(active||!ready||pendingStart||chatBusy)return;
      clearError();
      if(!navigator.onLine){showError({kind:'offline'},true);return;}
      if(!window.isSecureContext||!navigator.mediaDevices?.getUserMedia){showError({name:'SecurityError'},true);return;}
      pendingStart=true;phase='preparing';lastEnd={kind:'none',at:0};
      active=true;muted=false;start.hidden=true;stop.hidden=false;stop.focus({preventScroll:true});
      orb.dataset.active='true';const attempt=++generation;
      controls();record('call-start');status.textContent='A preparar uma nova conversa…';transcript.textContent='Autoriza o microfone quando o navegador pedir.';timer.textContent='';
      connectTimer=setTimeout(()=>{if(active&&attempt===generation)showError({kind:'connect-timeout'});},45000);
      try{
        await prepareSession();
        if(attempt!==generation||!active)return;
        if(typeof messenger.presenter?.toggleBidiSession!=='function')throw {kind:'sdk-load'};
        phase='connecting';status.textContent='A ligar…';
        const stream=await messenger.presenter.toggleBidiSession(true);
        if(attempt!==generation||!active){stream?.getTracks().forEach(track=>track.stop());if(!active)messenger.presenter?.terminateBidiClient?.();return;}
        if(!stream){showError({kind:'empty-stream'});return;}
        mediaStream=stream;startMeter(stream);mute.hidden=false;mute.setAttribute('aria-pressed','false');mute.setAttribute('aria-label','Silenciar microfone');mute.title='Silenciar microfone';document.getElementById('mute-slash').setAttribute('hidden','');
        stream.getAudioTracks().forEach(track=>track.addEventListener('ended',()=>{if(active&&mediaStream===stream)showError({name:'NotReadableError'});}));
        await applyVoicePreference();
      }catch(failure){if(attempt===generation)showError(failure);}
      finally{pendingStart=false;controls();}
    }
    start.addEventListener('click',startCall);
    stop.addEventListener('click',()=>{const pending=pendingStart;finish();if(pending)presentError({kind:'pending-cancel'});else clearError();});
    mute.addEventListener('click',()=>{
      if(!active||!mediaStream)return;
      muted=!muted;mediaStream.getAudioTracks().forEach(track=>track.enabled=!muted);
      record(muted?'microphone-muted':'microphone-unmuted');
      mute.setAttribute('aria-pressed',String(muted));mute.setAttribute('aria-label',muted?'Ativar microfone':'Silenciar microfone');mute.title=mute.getAttribute('aria-label');
      document.getElementById('mute-slash').toggleAttribute('hidden',!muted);orb.dataset.muted=String(muted);orbWrap.dataset.activity='';status.textContent=muted?'Microfone silenciado':'A ouvir';
    });
    messenger.addEventListener('chat-messenger-connect-bidi',()=>{
      if(!active||phase==='preparing')return;
      connected=true;phase='connected';clearTimeout(connectTimer);record('connected');status.textContent='A ouvir';transcript.textContent='Microfone ativo. Podes começar a falar.';
      if(!tick){
        startedAt=Date.now();timer.textContent='0:00';
        limit=setTimeout(()=>finish('Limite de teste atingido (4 min)','limit'),240000);
        tick=setInterval(()=>{
          const s=Math.floor((Date.now()-startedAt)/1000);timer.textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0');
          if(pendingResponseAt&&Date.now()-pendingResponseAt>20000&&error.hidden){record('response-slow');presentError({kind:'response-timeout'});}
          if(s>=240)finish('Limite de teste atingido (4 min)','limit');
        },1000);
      }
      applyVoicePreference();
    });
    function responseArrived(){pendingResponseAt=0;if(error.dataset.kind==='response-timeout')clearError();}
    messenger.addEventListener('chat-messenger-bidi-transcript-updated',({detail})=>{if(active&&detail?.transcript){transcript.textContent='Tu: '+detail.transcript;pendingResponseAt=Date.now();}});
    messenger.addEventListener('chat-messenger-bidi-utterance-updated',({detail})=>{if(active&&detail?.utterance){transcript.textContent=detail.utterance;responseArrived();}});
    messenger.addEventListener('chat-messenger-audio-playback-payload',({detail})=>{
      if(!active||!detail?.audio?.length)return;
      const mean=detail.audio.reduce((sum,n)=>sum+n,0)/detail.audio.length;
      outputLevel=Math.min(1,Math.sqrt(mean/100)*1.8);if(mean>1.5){outputAt=performance.now();responseArrived();}
    });
    messenger.addEventListener('chat-messenger-disconnect-bidi',()=>{
      record('disconnected');if(!active||phase==='preparing')return;
      finish('Ligação interrompida','disconnect');presentError({kind:'stream'});
    });
    messenger.addEventListener('chat-messenger-session-ended',()=>{
      record('agent-ended');
      if(active){finish('O assistente terminou a conversa','remote');clearError();}
      else if(lastEnd.kind==='disconnect'&&Date.now()-lastEnd.at<2000){status.textContent='O assistente terminou a conversa';clearError();lastEnd.kind='remote';}
    });
    messenger.addEventListener('chat-messenger-error',e=>showError(e.detail||{}));
    messenger.addEventListener('chat-messenger-error-v2',e=>showError(e.detail||{}));
    function addChatMessage(role,text){
      document.getElementById('chat-empty')?.remove();
      const item=document.createElement('div');item.className='chat-message';item.dataset.role=role;
      const who=document.createElement('strong');who.textContent=role==='user'?'Tu':'Assistente';
      const body=document.createElement('span');body.textContent=text;item.append(who,body);chatLog.append(item);chatLog.scrollTop=chatLog.scrollHeight;
    }
    messenger.addEventListener('chat-messenger-response-received',({detail})=>{
      if(!chatBusy||demo.dataset.mode!=='chat')return;
      const text=(detail?.messages||[]).filter(m=>m.type==='text'&&typeof m.text==='string').map(m=>m.text).join('\n');
      if(text){chatResponseCount++;addChatMessage('agent',text);chatStatus.textContent='Resposta recebida.';if(['response-timeout','chat-response-timeout'].includes(error.dataset.kind))clearError();}
    });
    document.getElementById('chat-form').addEventListener('submit',async event=>{
      event.preventDefault();const text=chatInput.value.trim();if(!text||chatBusy||active||pendingStart||!ready)return;
      if(!navigator.onLine){showError({kind:'offline'},true);return;}
      clearError();chatBusy=true;const attempt=++chatGeneration;const responseBefore=chatResponseCount;controls();chatStatus.textContent='A aguardar resposta…';addChatMessage('user',text);chatInput.value='';record('chat-request');
      chatTimer=setTimeout(()=>{if(chatBusy&&attempt===chatGeneration){chatStatus.textContent='A resposta está a demorar. Não reenviámos a mensagem.';presentError({kind:'chat-response-timeout'});}},20000);
      try{
        await waitForToken();if(attempt!==chatGeneration)return;hasSession=true;
        const prefix=!preferenceSent&&preferences[language.value]?preferences[language.value]+'\n\n':'';preferenceSent=true;
        await messenger.sendQuery(prefix+text);
        if(attempt===chatGeneration&&responseBefore===chatResponseCount&&error.hidden)chatStatus.textContent='O pedido terminou sem resposta de texto. Consulta o diagnóstico ou inicia uma nova conversa.';
      }catch(failure){if(attempt===chatGeneration)showError(failure);}
      finally{if(attempt===chatGeneration){chatBusy=false;clearTimeout(chatTimer);controls();}}
    });
    retry.addEventListener('click',async()=>{
      if(pendingStart||chatBusy)return;
      if(demo.dataset.mode==='voice'){finish('A iniciar uma nova conversa','retry');startCall();}
      else{clearError();pendingStart=true;controls();chatStatus.textContent='A preparar uma nova conversa…';try{await prepareSession();chatStatus.textContent='Nova conversa pronta. Escreve a tua mensagem.';chatLog.replaceChildren();}catch(failure){showError(failure,true);}finally{pendingStart=false;controls();}}
    });
    reload.addEventListener('click',()=>{finish('A atualizar','reload');location.reload();});
    language.addEventListener('change',()=>{preferenceSent=false;record('language-selected');document.getElementById('language-hint').textContent=language.value==='auto'?'Fala na língua pretendida.':'Preferência enviada na próxima conversa ou mensagem.';});
    function setMode(mode){
      if(mode===demo.dataset.mode)return;
      if(chatBusy||pendingStart)return;
      finish('Chamada terminada ao mudar de modo','mode');clearError();
      const voiceMode=mode==='voice';demo.dataset.mode=mode;voiceView.hidden=!voiceMode;chatView.hidden=voiceMode;record('mode-changed');
      for(const[tab,selected]of[[voiceTab,voiceMode],[chatTab,!voiceMode]]){tab.setAttribute('aria-selected',String(selected));tab.tabIndex=selected?0:-1;}
    }
    voiceTab.addEventListener('click',()=>setMode('voice'));chatTab.addEventListener('click',()=>setMode('chat'));
    document.querySelector('.modes').addEventListener('keydown',event=>{
      if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;
      event.preventDefault();const mode=event.key==='Home'?'voice':event.key==='End'?'chat':demo.dataset.mode==='voice'?'chat':'voice';setMode(mode);(mode==='voice'?voiceTab:chatTab).focus();
    });
    document.getElementById('help-toggle').addEventListener('click',event=>{
      const panel=document.getElementById('help-panel');panel.hidden=!panel.hidden;event.currentTarget.setAttribute('aria-expanded',String(!panel.hidden));
      if(!panel.hidden)panel.scrollIntoView({block:'nearest',behavior:'instant'});
    });
    document.getElementById('copy-diagnostics').addEventListener('click',async()=>{
      const feedback=document.getElementById('copy-status');
      try{await navigator.clipboard.writeText(document.getElementById('diagnostic-output').textContent);feedback.textContent=' Diagnóstico copiado.';}catch{feedback.textContent=' Não foi possível copiar. Seleciona o registo abaixo manualmente.';}
    });
    window.addEventListener('offline',()=>{record('offline');if(active||chatBusy)showError({kind:'offline'},true);controls();});
    window.addEventListener('online',()=>{record('online');controls();});
    window.addEventListener('error',event=>{if(event.filename?.startsWith('https://www.gstatic.com/chat-messenger/'))record('sdk-ui-exception');});
    window.addEventListener('pagehide',()=>finish('Página fechada','pagehide'));
  </script>
</body>
</html>
